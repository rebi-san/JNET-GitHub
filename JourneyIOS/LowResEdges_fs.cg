#include "Migratory.sh"
// Notes:  Detects edges in the low res additive and blended buffers, which can
//         later be used as a mask for a second pass that renders at high res.
//
// Author: John Edwards
// Date C: 7-20-2011

#ifndef _IOS64

float2 offsets[4];

float addMult;
float alphaMult;

D_DECLARE_TEXTURE2D_4(texAdd);
D_DECLARE_TEXTURE2D_4(texBlend);

struct v2f
{
	float4 position VS_ATTR(POSITION);
	float2 uv       VS_ATTR(TEXCOORD0);
};

struct f2f
{
    float4 color    : FINAL_COLOR;
};

#endif



//----------------------------------------------
// Program entry
//----------------------------------------------
//void main( v2f IN, out f2f OUT )
//{

FS_START(float4,
    TEX2(
        2D, texAdd,
        2D, texBlend),)

	half3 am = (half3)tex2D( texAdd, input.uv ).rgb;
	half3 ar = (half3)tex2D( texAdd, input.uv + GET_LOCAL(offsets[0]) ).rgb;
	half3 al = (half3)tex2D( texAdd, input.uv + GET_LOCAL(offsets[1]) ).rgb;
	half3 at = (half3)tex2D( texAdd, input.uv + GET_LOCAL(offsets[2]) ).rgb;
	half3 ab = (half3)tex2D( texAdd, input.uv + GET_LOCAL(offsets[3]) ).rgb;

	half bm = tex2D( texBlend, input.uv ).a;
	half br = tex2D( texBlend, input.uv + GET_LOCAL(offsets[0]) ).a;
	half bl = tex2D( texBlend, input.uv + GET_LOCAL(offsets[1]) ).a;
	half bt = tex2D( texBlend, input.uv + GET_LOCAL(offsets[2]) ).a;
	half bb = tex2D( texBlend, input.uv + GET_LOCAL(offsets[3]) ).a;

	half3 sobelAdd = abs( 4.0 * am - (ar + al + at + ab) );
	half sobelBlend = abs( 4.0 * bm - (br + bl + bt + bb) );

	half addLum = dot( sobelAdd, half3( 0.3, 0.59, 0.11 ) );

	output = max( GET_LOCAL(addMult) * addLum, GET_LOCAL(alphaMult) * sobelBlend );

SH_END()

