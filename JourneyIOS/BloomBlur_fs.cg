#include "Migratory.sh"
// Notes:  Intended to be used for the parts of the bloom that require a full Gaussian blur.
//
// Author: John Edwards
// Date C: 4-8-2011

// Increasing the register count reduces texture pipeline stalls in texture-heavy shaders.
#if defined(D_PLATFORM_GCM)
#pragma regcount 20
#endif

#define ourBlendState NoBlend_BlendState
#define ourDepthStencilState NoDepthTest_NoDepthWrite_DepthState
#define ourRasterState NoCull_RasterizerState

#ifndef _IOS64

struct v2f
{
	float4 position    VS_ATTR(POSITION);
	float2 uv          VS_ATTR(TEXCOORD0);
};

struct f2f
{
    HALF4 color        : FINAL_COLOR;
};

#if defined( TAP_4 ) || defined( TAP_8 ) || defined( TAP_16 )
	HALF4 weights0;
	HALF4 weights1;
	HALF4 weights2;
	HALF4 weights3;
	float4 offsets0; 
	float4 offsets1; 
	float4 offsets2; 
	float4 offsets3; 	
#endif	
#if defined( TAP_8 ) || defined( TAP_16 )	
	HALF4 weights4;
	HALF4 weights5;
	HALF4 weights6;
	HALF4 weights7;
	float4 offsets4; 
	float4 offsets5; 
	float4 offsets6; 
	float4 offsets7; 
#endif
#if defined( TAP_16 )			
	HALF4 weights8;	
	HALF4 weights9;
	HALF4 weights10;
	HALF4 weights11;
	HALF4 weights12;
	HALF4 weights13;
	HALF4 weights14;
	HALF4 weights15;
	float4 offsets8; 
	float4 offsets9; 
	float4 offsets10; 
	float4 offsets11; 
	float4 offsets12; 
	float4 offsets13; 
	float4 offsets14; 
	float4 offsets15; 
#endif

D_DECLARE_TEXTURE2D_4(tex);

#ifdef COMPOSITE
 float size;
 D_DECLARE_TEXTURE2D_4(texComp);
#endif

#endif


//----------------------------------------------
// Program entry
//----------------------------------------------
//void main( v2f IN, out f2f OUT )

#define OUTPUT_TYPE float4


FS_START(OUTPUT_TYPE,
    TEX2(
        2D, tex,
        2D, texComp),)

	output.rgb = 0;
#if defined( TAP_4 ) || defined( TAP_8 ) || defined( TAP_16 )
		output += (OUTPUT_TYPE)GET_LOCAL(weights0) * (OUTPUT_TYPE)tex2D( tex, input.uv + GET_LOCAL(offsets0.xy) );
		output += (OUTPUT_TYPE)GET_LOCAL(weights1) * (OUTPUT_TYPE)tex2D( tex, input.uv + GET_LOCAL(offsets1.xy) );
		output += (OUTPUT_TYPE)GET_LOCAL(weights2) * (OUTPUT_TYPE)tex2D( tex, input.uv + GET_LOCAL(offsets2.xy) );
		output += (OUTPUT_TYPE)GET_LOCAL(weights3) * (OUTPUT_TYPE)tex2D( tex, input.uv + GET_LOCAL(offsets3.xy) );
#endif
#if defined( TAP_8 ) || defined( TAP_16 )
		output += (OUTPUT_TYPE)GET_LOCAL(weights4) * (OUTPUT_TYPE)tex2D( tex, input.uv + GET_LOCAL(offsets4.xy) );
		output += (OUTPUT_TYPE)GET_LOCAL(weights5) * (OUTPUT_TYPE)tex2D( tex, input.uv + GET_LOCAL(offsets5.xy) );
		output += (OUTPUT_TYPE)GET_LOCAL(weights6) * (OUTPUT_TYPE)tex2D( tex, input.uv + GET_LOCAL(offsets6.xy) );
		output += (OUTPUT_TYPE)GET_LOCAL(weights7) * (OUTPUT_TYPE)tex2D( tex, input.uv + GET_LOCAL(offsets7.xy) );
#endif
#if  defined( TAP_16 )
		output += (OUTPUT_TYPE)GET_LOCAL(weights8) * (OUTPUT_TYPE)tex2D( tex, input.uv + GET_LOCAL(offsets8.xy) );
		output += (OUTPUT_TYPE)GET_LOCAL(weights9) * (OUTPUT_TYPE)tex2D( tex, input.uv + GET_LOCAL(offsets9.xy) );
		output += (OUTPUT_TYPE)GET_LOCAL(weights10) * (OUTPUT_TYPE)tex2D( tex, input.uv + GET_LOCAL(offsets10.xy) );
		output += (OUTPUT_TYPE)GET_LOCAL(weights11) * (OUTPUT_TYPE)tex2D( tex, input.uv + GET_LOCAL(offsets11.xy) );
		output += (OUTPUT_TYPE)GET_LOCAL(weights12) * (OUTPUT_TYPE)tex2D( tex, input.uv + GET_LOCAL(offsets12.xy) );
		output += (OUTPUT_TYPE)GET_LOCAL(weights13) * (OUTPUT_TYPE)tex2D( tex, input.uv + GET_LOCAL(offsets13.xy) );
		output += (OUTPUT_TYPE)GET_LOCAL(weights14) * (OUTPUT_TYPE)tex2D( tex, input.uv + GET_LOCAL(offsets14.xy) );
		output += (OUTPUT_TYPE)GET_LOCAL(weights15) * (OUTPUT_TYPE)tex2D( tex, input.uv + GET_LOCAL(offsets15.xy) );
#endif

#ifdef COMPOSITE
	output += GET_LOCAL(size) * (OUTPUT_TYPE)tex2D( texComp, input.uv );
#endif
	output.a = 1.0f;

SH_END()
