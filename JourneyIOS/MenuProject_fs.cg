
#ifndef _IOS64

struct v2f
{
	float4 position    VS_ATTR(POSITION);
	float2 uv          VS_ATTR(TEXCOORD0);
};

struct f2f
{
    float4 color        : FINAL_COLOR;
};

D_DECLARE_TEXTURE2D_4(ourTexture);
D_DECLARE_TEXTURE2D_4(backgroundTex);

float blendValue;

#endif

//void main( v2f vi, out f2f vo )
//{

FS_START(float4,
    TEX2(
        2D, ourTexture,
        2D, backgroundTex),)

	float alpha = 0.f;

#if 1
    alpha = tex2D(backgroundTex, input.uv).r;  //backgroundTex.Sample(LinearClampSampler, vi.uv).a;
#else
    const float kDelta = 0.001f;
	for(int y=0; y<3; ++y)
	{
		float v = vi.uv.y + (-1+y)*kDelta*(16.f/9.f);
		for(int x=0; x<3; ++x)
		{
			float u = vi.uv.x + (-1+x)*kDelta;
			alpha += backgroundTex.Sample(LinearClampSampler, float2(u, v)).a;
		}
	}
	alpha *= 0.11f;
#endif

	alpha = min(alpha, 0.33f);

    output = tex2D(ourTexture, input.uv);// ourTexture.Sample(LinearClampSampler, vi.uv);

	output.a = max(output.a, alpha);
	output.a *= GET_LOCAL(blendValue);

SH_END()

//}

