
#include "Migratory.sh"

struct a2v
{
	float4 position    VS_ATTR(POSITION);
	float2 uv          VS_ATTR(TEXCOORD0);
};

struct v2f
{
	float4 position    FS_ATTR(POSITION);
	float2 uv          FS_ATTR(TEXCOORD0);
};

//----------------------------------------------
// Program entry
//----------------------------------------------
VS_START()

	output.position = input.position;
#if defined(D_PLATFORM_D3D11) || defined(_IOS64)
	output.uv = float2(input.uv.x,1-input.uv.y);
#else
	output.uv = input.uv;
#endif

SH_END()

