// Debanding shader
// Griff June 2014.

#include "Migratory.sh"


#ifndef _IOS64

D_DECLARE_TEXTURE2D_4(texColor);


struct v2f
{
	float4 position VS_ATTR(POSITION);
	float2 uv       VS_ATTR(TEXCOORD0);
};

struct f2f
{
	float4 color : FINAL_COLOR;
};

float timeSeed;

#endif

inline HALF2 nrand(HALF2 n)
{
    HALF2 result;
    result.x = frac(sin(dot(n.xy, HALF2(12.9898, 78.233)))* 43758.5453);
    result.y = frac(cos(fmod( 123456789.0, 1e-7 + 256. * dot(HALF2(23.1406926327792690,2.6651441426902251),n) ) ) );
    return result;
}

//----------------------------------------------
// Program entry
//----------------------------------------------
//void main( in v2f IN, out f2f OUT )
//{


FS_START(HALF4,
    TEX1(
        2D, texColor),)

#ifdef D_PLATFORM_GXM	
	OUT.color = 1.0f;
#else
	HALF2 uv = HALF2(input.uv);
	HALF2 invViewportSize;
#ifdef _IOS64
    invViewportSize.x = texColor.tx.get_width();
    invViewportSize.y = texColor.tx.get_height();
#else
	texColor.GetDimensions(invViewportSize.x,invViewportSize.y);
#endif
	invViewportSize.x = 1.h / invViewportSize.x;
	invViewportSize.y = 1.h / invViewportSize.y;
	
	HALF2 rand = nrand(uv+frac(GET_LOCAL(timeSeed)));
	HALF2 offset = (rand * HALF2(31.0,31.0)) - 15.0;

	//HALF4 tap = h4tex2D( texColor, uv);
    HALF4 tap = (HALF4)tex2D(texColor, float2(uv.xy) );

	//HALF4 randomtap = h4tex2D( texColor, uv + (offset * invViewportSize.xy));
    HALF2 uv2 = uv + (offset * invViewportSize.xy);
    HALF4 randomtap = (HALF4)tex2D(texColor, float2(uv2)  );
	
	HALF4 diff = abs(tap-randomtap);
	HALF sum_diff = diff.x+diff.y+diff.z;
	
	output = (sum_diff < (6.0/255.0)) ? randomtap : tap;
#endif

SH_END()
	

