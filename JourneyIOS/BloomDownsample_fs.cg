#include "Migratory.sh"
// Notes:  By doing a slight blur when downsampling the bloom buffers we can
//         get around some precision issues that otherwise cause some bright
//         pixels to be lost.
//
// Author: John Edwards
// Date C: 4-11-2011

// Increasing the register count reduces texture pipeline stalls in texture-heavy shaders.

#if defined(D_PLATFORM_GCM)
#pragma regcount 40
#endif

#define ourBlendState NoBlend_BlendState
#define ourDepthStencilState NoDepthTest_NoDepthWrite_DepthState
#define ourRasterState NoCull_RasterizerState


#ifndef _IOS64

struct v2f
{
	float4 position        VS_ATTR(POSITION);
	float2 uv              VS_ATTR(TEXCOORD0);
};

struct f2f
{
    float4 color           : FINAL_COLOR;
};

float4 offsets0;
float4 offsets1;
float4 offsets2;
float4 offsets3;
D_DECLARE_TEXTURE2D_4(tex);

#endif

//----------------------------------------------
// Program entry
//----------------------------------------------
FS_START(float4,
TEX1(
    2D, tex),)

	output = 0.25 *
		( tex2D( tex, input.uv + GET_LOCAL(offsets0.xy) )
		+ tex2D( tex, input.uv + GET_LOCAL(offsets1.xy) )
		+ tex2D( tex, input.uv + GET_LOCAL(offsets2.xy) )
		+ tex2D( tex, input.uv + GET_LOCAL(offsets3.xy) ) );

SH_END()

