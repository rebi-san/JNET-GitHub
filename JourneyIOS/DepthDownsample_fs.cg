#include "Migratory.sh"


#ifndef _IOS64

#ifdef MSAA
	Texture2DMS<float> texDepthMSAA;
#else
	D_DECLARE_TEXTURE2D_4(texDepth);
#endif

struct v2f
{
	float4 position        VS_ATTR(POSITION);
	float2 uv              VS_ATTR(TEXCOORD0);
};

#endif

struct f2f
{
    #if defined(D_PLATFORM_D3D11) || defined(D_PLATFORM_GNM)
        float depth            : SV_Depth;
    #elif defined(_IOS64)
        float depth FS_ATTR(HW_DEPTH);
    #else
        HW_DEPTH: DEPTH;
    #endif
};


#define myTexDepth2D( _depthTex, uv )	tex2D( _depthTex, uv ).r

//----------------------------------------------
// Program entry
//----------------------------------------------
//void main( in v2f IN, out f2f OUT )
//{

FS_START(f2f,
    TEX1(
        2D, texDepth),)

	// We can downsample correctly ...
	//const float SCALE = 1.0;
	/*OUT.depth =  min( min( min(
		myTexDepth2D( texDepth, IN.uv + SCALE * float2(  pixel.x,  pixel.y ) ),
		myTexDepth2D( texDepth, IN.uv + SCALE * float2( -pixel.x,  pixel.y ) ) ),
		myTexDepth2D( texDepth, IN.uv + SCALE * float2( -pixel.x, -pixel.y ) ) ),
		myTexDepth2D( texDepth, IN.uv + SCALE * float2(  pixel.x, -pixel.y ) ) );*/
	// ... or we can do it the fast way.  Doesn't seem to look any worse for
	// how we're using it.

#ifdef MSAA
	uint2 dim;
	uint sampleCount;
	texDepthMSAA.GetDimensions(dim.x, dim.y, sampleCount);

	float result = 1;
	float2 uvCoord = IN.uv * float2(dim);


	for (uint i = 0; i < sampleCount; ++i)
	{
		result = min(result, texDepthMSAA.Load(uvCoord, i).r);
	}

	output.depth = result;

#else
	output.depth = myTexDepth2D( texDepth, input.uv );
#endif

SH_END()
