#include "Migratory.sh"
// Notes:  Stores color in Fp16 LUV format.  This is the HDR format EdgePost expects.
//
// Author: John Edwards
// Date C: 5-31-2010

sampler2D texColor;

struct v2f
{
	float4 position VS_ATTR(POSITION);
	float2 uv       VS_ATTR(TEXCOORD0);
};

struct f2f
{
	float4 color VS_ATTR(COLOR0);
};

//----------------------------------------------
// Helper functions
//----------------------------------------------
float4 _FP16LuvEncode(in float3 vRGB) // Taken from the Edge samples
{
	const static float3x3 M = float3x3
	(
	   0.2209, 0.3390, 0.4184,
	   0.1138, 0.6780, 0.7319,
	   0.0102, 0.1130, 0.2969
	);

	float4 vResult;
	float3 Xp_Y_XYZp = mul(vRGB, M);
	Xp_Y_XYZp = max(Xp_Y_XYZp, float3(1e-6, 1e-6, 1e-6));
	vResult.xy = Xp_Y_XYZp.xy / Xp_Y_XYZp.z;
	vResult.zw = unpack_4ubyte( pack_2half( Xp_Y_XYZp.y )).xy;
	return vResult;
}

//----------------------------------------------
// Program entry
//----------------------------------------------
void main( in v2f IN, out f2f OUT )
{
	OUT.color = _FP16LuvEncode( tex2D( texColor, IN.uv ).rgb );
}
