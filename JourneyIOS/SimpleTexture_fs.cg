
#include "Migratory.sh"

D_DECLARE_TEXTURE2D_4(ourTexture);

struct v2f
{
	float4 position    VS_ATTR(POSITION);
	float2 uv          VS_ATTR(TEXCOORD0);
};

struct f2f
{
    half4 color        : FINAL_COLOR;
};

//----------------------------------------------
// Program entry
//----------------------------------------------
void main( v2f IN, out f2f OUT )
{
	OUT.color = D_SAMPLE_TEXTURE(ourTexture,IN.uv);
}
