

#ifndef _IOS64

struct v2f
{
	float4 position    VS_ATTR(POSITION);
#ifdef TEXTURE_UVW
	float3 uv          VS_ATTR(TEXCOORD0);
#else
	float2 uv          VS_ATTR(TEXCOORD0);
#endif
};

struct f2f
{
    float4 color        : FINAL_COLOR;
};


#if defined(TEXTURE_3D) && !defined(D_PLATFORM_GXM)
	D_DECLARE_TEXTURE3D_4(ourTexture);
#elif defined(TEXTURE_UVW)
	D_DECLARE_TEXTURE_CUBE_4(ourTexture);
#elif defined(D_PLATFORM_D3D11) && defined(TEXTURE_STENCIL)
	#define D_D3D_STENCIL
	#include	"d3dutils.sh"
#else
	D_DECLARE_TEXTURE2D_4(ourTexture);
#endif

#if defined(TEXTURE_DIFF_RED)
	D_DECLARE_TEXTURE2D_4(cmpTexture);
#endif

#if defined(TEXTURE_RED_DELTA)
	float4 textureUvOffset;
#endif

#if defined(TEXTURE_RED_LEVEL)
	float textureLevel;
#endif

#ifdef TEXTURE_TEX2D_ALPHA
float blendValue;
#endif

#endif


#define myTexDepth2D( depthTex,  uv )    tex2D( depthTex, uv ).r
#define myTexStencil2D( stencilTex,  uv ) tex2D( stencilTex, uv ).w




#if defined(TEXTURE_3D) && !defined(D_PLATFORM_GXM)
FS_START(float4,TEX1(3D, ourTexture),)
	output = tex3D(ourTexture,input.uv);
#elif defined(TEXTURE_UVW)
FS_START(float4,TEX1(CUBE, ourTexture),)
	output = texCUBE(ourTexture,input.uv);
#elif defined(TEXTURE_DEPTH)
FS_START(float4,TEX1(2D, ourTexture),)
	float d = myTexDepth2D( ourTexture, input.uv );
	output = float4(d,frac(d*40),frac(d*1600),1);
#elif defined(TEXTURE_STENCIL)
FS_START(float4,TEX1(2D, ourTexture),)
  #ifdef D_PLATFORM_D3D11
	float	d = GetStencilMask(input.uv);
	output = d + stencil_testColors;
  #else
	float s = myTexStencil2D( ourTexture, input.uv );
	output = float4(s*32.0,s*32.0,s*32.0,1);
  #endif
#elif defined(TEXTURE_ALPHA)
FS_START(float4,TEX1(2D, ourTexture),)
	float a = tex2D(ourTexture,input.uv).a;
	output = float4(a,a,a,1);
#elif defined(TEXTURE_RED)
FS_START(float4,TEX1(2D, ourTexture),)
	float r = tex2D(ourTexture,input.uv).r;
	output = float4(r,r,r,1);
#elif defined(TEXTURE_RED_LEVEL)
FS_START(float4,TEX1(2D, ourTexture),)
    float r = tex2D(ourTexture,input.uv).r;//,CBL(textureLevel)).r;
	output = float4(r,r,r,1);
#elif defined(TEXTURE_GREEN)
FS_START(float4,TEX1(2D, ourTexture),)
	float g = tex2D(ourTexture,input.uv).g;
	output = float4(g,g,g,1);
#elif defined(TEXTURE_BLUE)
FS_START(float4,TEX1(2D, ourTexture),)
	float b = tex2D(ourTexture,input.uv).b;
	output = float4(b,b,b,1);
#elif defined(TEXTURE_DIFF_RED)
FS_START(float4,TEX1(2D, ourTexture),)
	float c0 = tex2D(ourTexture,input.uv).r;
	float c1 = tex2D(cmpTexture,input.uv).r;
	float cd = abs(c0-c1);
	output = float4(cd,cd*10,cd*100,1);
#elif defined(TEXTURE_RED_DELTA)
FS_START(float4,TEX1(2D, ourTexture),)
	float r = tex2D(ourTexture,frac(input.uv+textureUvOffset.xy)).r;
	output = float4(r,r,r,1);
#elif defined(TEXTURE_TEX2D_ALPHA)
FS_START(float4,TEX1(2D, ourTexture),)
	output = tex2D(ourTexture,input.uv);
	output.a *= blendValue;
#else
FS_START(float4,TEX1(2D, ourTexture),)
	output = tex2D(ourTexture,input.uv);
#endif

SH_END()


