#include "Migratory.sh"

#ifndef _IOS64

// Env params:
float4 l_c,l_a;
float3 l_d;
float velvetInt, velvetRatio;
float terrainScale;
D_DECLARE_TEXTURE2D_4(terrainHeightMap);

D_DECLARE_TEXTURE2D_4(texColorShadow);

struct v2f
{
	float4 position VS_ATTR(POSITION);
	float4 color    VS_ATTR(COLOR0);
	float3 normal   VS_ATTR(TEXCOORD1);
	float3 eye      VS_ATTR(TEXCOORD2);
	float3 loc      VS_ATTR(TEXCOORD3);
	float4 fog      VS_ATTR(TEXCOORD4);
};

struct f2f
{
    float4 color           : FINAL_COLOR;
};

#endif


#ifdef _IOS64

inline float4 lit(PASS_UG float fNDotL, float fRDotV, float specular)
{
    float4 amb = GET_GLOBAL(l_a) + GET_GLOBAL(l_c) * saturate(fNDotL);
    float4 spec = GET_GLOBAL(l_c) * pow(fRDotV, fNDotL);
    return amb + spec;
}

#endif

//----------------------------------------------
// Program entry
//----------------------------------------------

FS_START(float4,
    TEX2(
        2D, terrainHeightMap,
        2D, texColorShadow),)

	//input.color *= 0.5; //@HACK: Reducing the occlusion range looks better in lvl 1.
	float4 aoColor = float4( (input.color - 0.5) * 0.125 + 0.5 ); // The occlusion contrast generated by dune geo is quite low.

	float3 Ln = normalize( GET_GLOBAL(l_d).xyz );
	float3 Nn = normalize( input.normal );
	float3 Vn = normalize( input.eye.xyz );
	float3 Hn = normalize( Vn + Ln );
	float specRatio = GET_GLOBAL(velvetRatio)/3;
	float4 litV = lit( UG, dot( Ln, Nn ), dot( Hn, Nn ), specRatio );
    float glitterSpec = 5*litV.y * litV.z * GET_GLOBAL(velvetInt); (void)glitterSpec;

	//TOON shader
    float high = 0.05; (void)high;
    float low = 0; (void)low;
	//float lightInt = (litV.y>high)?1:(litV.y<=low)?0:(litV.y-low)/(high-low);
	//float lightInt = (litV.y>0)?1:0;
	float lightInt = 1;

	//velvet
	float cosView = saturate(dot( Vn, Nn ));
	float velvet = GET_GLOBAL(velvetInt) * pow( 1.0 - cosView * cosView, 2 * GET_GLOBAL(velvetRatio) );
    float glitterVelvet = GET_GLOBAL(velvetInt)*pow( 1.0 - cosView * cosView, specRatio ); (void)glitterVelvet;
	//velvet = 0;

	float distFade = 1.0 / (length( input.eye.xyz )+0.001);
	distFade = saturate( 15 * distFade * distFade );

    float kHeightAboveTerrain = 0.05; (void)kHeightAboveTerrain;
    float kMaxDepth = 0.12/distFade; (void)kMaxDepth;

	float terrainX = 1 - ( GET_LOCAL(terrainScale) * input.loc.x + 0.5 ) / 256;
	float terrainZ = ( GET_LOCAL(terrainScale) * input.loc.z + 0.5 ) / 512;
	//float heightVal = 2 * ( input.color.r - 0.5 );

	// Use dune cell texture for ao lookup
	float heightVal = 5 * ( aoColor.r - 0.5 ) * min(2.f,length(input.eye)*.075f);

	float4 duneMap = tex2D( texColorShadow, float2( terrainX, terrainZ ) );

	float3 midColor = duneMap.rgb;

	float luminance = dot( midColor, float3( 0.59, 0.3, 0.11 ) );
	float3 lowColor = lerp( float3( luminance, luminance, luminance ), midColor, 1.25 );	// This last number affects the saturation
	float3 highColor = midColor;

	lowColor *= 0.5;
	highColor *= 1.25;

	float3 duneColor = ( heightVal < 0 ) 
		? lerp( midColor, lowColor, -heightVal )
		: lerp( midColor, highColor, heightVal );

	float2 uv;
	uv.x = input.loc.x / 256;
	uv.y = input.loc.z / 512;

	float4 color;
	float shadow = saturate( duneMap.a );
	velvet = 0.7*velvet + 0.3*saturate( velvet * 20 * heightVal );
	color.rgb = duneColor * ( ( lightInt + velvet ) * GET_GLOBAL(l_c.rgb) * shadow + GET_GLOBAL(l_a.rgb) );

	output.rgb = lerp( color.rgb, input.fog.rgb, input.fog.a );

	output.a = 1;

SH_END()

