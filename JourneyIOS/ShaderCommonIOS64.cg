#define CBG(xxx)                        UG.xxx
#define CBL(xxx)                        UL.xxx
#define PASS_UL                 constant UniformLocal &UL,
#define PASS_UG                 constant UniformGlobal &UG,

#define NO_CONST_VARS
#define UNIFORM_PASS_PARAM              UG,
#define DEPTHTEX_SAMPLER                sampler2D depthTex,

#define h4tex2D(X,Y)	(tex2D<half4>(X,Y))
#define h1tex2D(X,Y)	(h4tex2D(X,Y).r)
#define h2tex2D(X,Y)	(h4tex2D(X,Y).rg)
#define h3tex2D(X,Y)	(h4tex2D(X,Y).rgb)

#define f4tex2D(X,Y)	tex2D<float4>(X,Y)
#define f1tex2D(X,Y)	(f4tex2D(X,Y).r)
#define f2tex2D(X,Y)	(f4tex2D(X,Y).rg)
#define f3tex2D(X,Y)	(f4tex2D(X,Y).rgb)

#define h4texCUBE(X,Y)	(texCUBE<half4>(X,Y))
#define h1texCUBE(X,Y)	(h4texCUBE(X,Y).r))
#define h2texCUBE(X,Y)	(h4texCUBE(X,Y).rg)
#define h3texCUBE(X,Y)	(h4texCUBE(X,Y).rgb)

#define f4ReadTexProj(x,y)  ReadTexProj<float4>(x,y)
#define h4ReadTexProj(x,y)  ReadTexProj<half4>(x,y)

#define f1ReadDepth(x,y)    ReadDepth<float>(x,y)
#define h1ReadDepth(x,y)    ReadDepth<half>(x,(float2)y)

#define f1ReadDepthProj(x,y)    ReadDepthProj<float>(x,y)
#define h1ReadDepthProj(x,y)    ReadDepthProj<half>(x,y)





template<typename TPixel, typename TSampler, typename TTexCoord>
inline TPixel ReadTexProj( const TSampler tex, TTexCoord uv )
{
    return tex.tex.sample(tex.sampler,uv.xy/uv.w);
}

template<typename TPixel, typename TSampler, typename TTexCoord>
inline TPixel ReadDepth( const TSampler tex, TTexCoord uv )
{
    return tex.tex.sample(tex.sampler,uv.xy).r;
}

template<typename TPixel, typename TSampler, typename TTexCoord>
inline TPixel ReadDepthProj( const TSampler tex, TTexCoord uv )
{
    return tex.tex.sample(tex.sampler,uv.xy/uv.w).r;
}

inline int imodulo(float numer, uint denom)
{
    return ((int)floor(numer))%denom;
}

inline float3x3 ToF3x3(float4x4 m)
{
    return float3x3(m[0].xyz, m[1].xyz, m[2].xyz);
}

template<typename T0, typename T1>
inline T0 lerp(T0 a, T0 b, T1 v)
{
    return a + (b-a)*v;
}

template<typename M, typename V>
inline V mul(M m, V v)
{
    return v * m;
}

template<typename TSampler, typename TTexCoord, typename TPixel=float4>
inline TPixel tex2D( const TSampler tex, TTexCoord uv )
{
    return tex.tx.sample(tex.sm, float2(uv.xy) );
}

template<typename TSampler, typename TTexCoord, typename TPixel=float4>
inline TPixel tex2D( const TSampler tex, TTexCoord uv, float lodBias )
{
    return tex.tx.sample(tex.sm, float2(uv.xy), bias(lodBias) );
}

template<typename TSampler, typename TTexCoord, typename TPixel=float4>
inline TPixel tex3D( const TSampler tex, TTexCoord uv )
{
    return tex.tx.sample(tex.sm, float3(uv.xyz) );
}

template<typename TSampler, typename TTexCoord, typename TPixel=float4>
inline TPixel tex3D( const TSampler tex, TTexCoord uv, float lodBias )
{
    return tex.tx.sample(tex.sm, float3(uv.xyz), bias(lodBias) );
}

template<typename TSampler, typename TTexCoord, typename TPixel=float4>
inline TPixel texCUBE( const TSampler tex, TTexCoord uv )
{
    return tex.tx.sample(tex.sm, float3(uv.xyz));
}

template<typename TSampler, typename TTexCoord, typename TPixel=float4>
inline TPixel texCUBE( const TSampler tex, TTexCoord uv, float lodBias )
{
    return tex.tx.sample(tex.sm, float3(uv.xyz), bias(lodBias));
}

inline void DiscardLE( float alpha, float ref )
{
    if( alpha<=ref )
        discard_fragment();
}

inline void DiscardGE( float alpha, float ref )//=alphaRef
{
    if( alpha>=ref )
        discard_fragment();
}

inline float3x3 ToM3x3(float4x4 src)
{
    return float3x3(src[0].xyz,src[1].xyz,src[2].xyz);
}

inline float3x3 ToM3x3(float3x4 src)
{
    return float3x3(src[0].xyz,src[1].xyz,src[2].xyz);
}


#define SHADER_NO_PERSPECTIVE [[center_no_perspective]]


#define ConvertDepth(UL, depth)  (- (UL.cameraNearFar / (depth * UL.cameraFarMinusNear - UL.cameraFar)))

#define manualTexDepth2Dproj( _depthTex,  uv ) tex2D( _depthTex, uv.xy/uv.w ).r



////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

#define SKINNING_PALETTE_SIZE 32

inline float4 SkinTransform( float3x4 mtx, float4 pos )
{
    return float4(dot(mtx[0],pos), dot(mtx[1],pos), dot(mtx[2],pos), 1);
}

inline float3 SkinTransform( float3x4 mtx, float3 pos )
{
    return float3(dot(mtx[0].xyz,pos), dot(mtx[1].xyz,pos), dot(mtx[2].xyz,pos));
}

inline float3x4 GenerateBoneMatrix(constant const float3x4 *skinMatrices, int4 SkinIndices, float4 SkinWeights)
{
    return    skinMatrices[SkinIndices.x]*SkinWeights.x
    +    skinMatrices[SkinIndices.y]*SkinWeights.y
    +    skinMatrices[SkinIndices.z]*SkinWeights.z
    +    skinMatrices[SkinIndices.w]*SkinWeights.w;
}

