#ifdef HALVES_ENABLED
    #define HALF4 half4
    #define HALF3 half3
    #define HALF2 half2
    #define HALF half
#else
    #define HALF4 float4
    #define HALF3 float3
    #define HALF2 float2
    #define HALF float
#endif

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

constexpr constant half3 hToY = half3(0.299h,  0.587h,  0.114h);
constexpr constant half3 hToCb = half3(-0.169h, -0.331h,  0.5h);
constexpr constant half3 hToCr = half3(0.5h, -0.419h, -0.081h);

