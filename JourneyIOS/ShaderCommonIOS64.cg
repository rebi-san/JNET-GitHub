#ifdef ENABLE_ARGUMENT_BUFFERS

#define VS_START(textures)                  \
    struct VS_ArgBuffer { ARG_##textures }; \
    DECL_SHADERSTART(vertex, v2f)(          \
        SFP_INPUT(a2v input)                \
        UNIFORM_ED_GET(ENABLE)              \
        PVS_##textures)                     \
    {                                       \
        v2f output;                         \
        ARG_SMP_##textures;

#define FS_START(output_type, textures, textures2)         \
    struct FS_ArgBuffer { ARG_##textures };     \
    struct FS_ArgBuffer2 { ARG_##textures2 };     \
    DECL_SHADERSTART(fragment, output_type)(    \
        SFP_INPUT(v2f input)                    \
        UNIFORM_ED_GET(ENABLE)                  \
        PFS_##textures                         \
        PFS2_##textures2)                        \
    {                                           \
        output_type output;                     \
        ARG_SMP_##textures;                     \
        ARG2_SMP_##textures2;

#else

#define VS_START(textures)          \
    DECL_SHADERSTART(vertex, v2f)(  \
        SFP_INPUT(a2v input)        \
        UNIFORM_ED_GET(ENABLE)      \
        NOARG_##textures)           \
    {                               \
        v2f output;                 \
        NOARG_SMP_##textures;

#define FS_START(output_type, textures, textures2)         \
    DECL_SHADERSTART(fragment, output_type)(    \
        SFP_INPUT(v2f input)                    \
        UNIFORM_ED_GET(ENABLE)                  \
        NOARG_##textures                       \
        NOARG_##textures2)                       \
    {                                           \
        output_type output;                     \
        NOARG_SMP_##textures;                   \
        NOARG_SMP_##textures2;

#endif

#define SH_END()        \
        return output;  \
    }

