#define half4_ios half4

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// buffer indices
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

#define kBufferIndexLocalUniforms       0      // these two are used for our constant buffers
#define kBufferIndexGlobalUniforms      1
#define kBufferIndexArguments           2      // textures+samplers
#define kBufferIndexArguments2          3      // second argument buffer

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

#define DECL_CBUFFER_LOCAL	struct UniformLocal

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// the vertex shader input streams are hardcoded - that way we don't need to read them from the shader'
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

#define knVertexAttrPOSITION            0
#define knVertexAttrCOLOR0              1
#define knVertexAttrCOLOR1              2
#define knVertexAttrNORMAL              3
#define knVertexAttrTEXCOORD0           4
#define knVertexAttrTEXCOORD1           5
#define knVertexAttrTEXCOORD2           6
#define knVertexAttrTEXCOORD3           7
#define knVertexAttrTEXCOORD4           8
#define knVertexAttrTEXCOORD5           9
#define knVertexAttrTEXCOORD6           10
#define knVertexAttrTEXCOORD7           11
#define knVertexAttrBINORMAL            11
#define knVertexAttrBLENDWEIGHT         12
#define knVertexAttrBLENDINDICES        13      // this is an integer

#define knVertexAttrHW_POSITION         knVertexAttrPOSITION

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// the fragment shader alikes point to special items, such as hw positions, colors, and others...
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#define knFragmentAttrPOSITION          [[position]]
#define knFragmentAttrHW_POSITION       [[position]]
#define knFragmentAttrPSIZE             [[point_size]]
#define knFragmentAttrHW_DEPTH          [[depth(any)]]
#define knFragmentAttrHW_COLOR0         [[color(0)]]
#define knFragmentAttrHW_COLOR1         [[color(1)]]
#define knFragmentAttrHW_COLOR2         [[color(2)]]
#define knFragmentAttrHW_COLOR3         [[color(3)]]
#define knFragmentAttrSPRITECOORD       [[point_coord]]
#define knFragmentAttrCOLOR0
#define knFragmentAttrCOLOR1
#define knFragmentAttrNORMAL
#define knFragmentAttrTEXCOORD0
#define knFragmentAttrTEXCOORD1
#define knFragmentAttrTEXCOORD2
#define knFragmentAttrTEXCOORD3
#define knFragmentAttrTBINORMAL
#define knFragmentAttrTEXCOORD4
#define knFragmentAttrTEXCOORD5
#define knFragmentAttrTEXCOORD6
#define knFragmentAttrTEXCOORD7

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

typedef struct
{
    texture2d<float>		tx;
    sampler	sm;
} sampler2D;

typedef struct
{
    texture2d<half>         tx;
    sampler	sm;
} sampler2Dh;

typedef struct
{
    texture3d<float>        tx;
    sampler    sm;
} sampler3D;

typedef struct
{
    texture3d<half>         tx;
    sampler    sm;
} sampler3Dh;

typedef struct
{
    texturecube<float>		tx;
    sampler	sm;
} samplerCUBE;

typedef struct
{
    texturecube<half>		tx;
    sampler	sm;
} samplerCUBEh;

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

#define SFP_INPUT(decl)         decl [[stage_in]]
#define SFP_UNIFORM             , constant UniformLocal & UL [[ buffer(kBufferIndexLocalUniforms) ]], constant UniformGlobal & UG [[ buffer(kBufferIndexGlobalUniforms) ]]

#define UNIFORM_ED_ENABLE                   SFP_UNIFORM
#define UNIFORM_ED_DISABLE
#define UNIFORM_ED_GET(xxx)                 UNIFORM_ED_##xxx

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

#define ARG_SAMPLER(type, name)     sampler##type name = {arg.t_##name, arg.s_##name}; (void)name;
#define ARG2_SAMPLER(type, name)    sampler##type name = {arg2.t_##name, arg2.s_##name}; (void)name;

#define ARG_SFP_TEX2D(name)    texture2d<float> t_##name;      sampler s_##name;
#define ARG_SFP_TEX2Dh(name)   texture2d<half> t_##name;       sampler s_##name;
#define ARG_SFP_TEX3D(name)    texture3d<float> t_##name;      sampler s_##name;
#define ARG_SFP_TEX3Dh(name)   texture3d<half> t_##name;       sampler s_##name;
#define ARG_SFP_TEXCUBE(name)  texturecube<float> t_##name;    sampler s_##name;
#define ARG_SFP_TEXCUBEh(name) texturecube<half> t_##name;     sampler s_##name;

#define NOARG_SAMPLER(type, name)     sampler##type name = {t_##name, s_##name}; (void)name;


#if 1
    #define TEXDEF
    #define SMPDEF
#else
    #define TEXDEF [[texture(__COUNTER__/2)]]
    #define SMPDEF [[sampler(__COUNTER__/2)]]
#endif


#define NOARG_SFP_TEX2D(name)   , texture2d<float> t_##name TEXDEF    , sampler s_##name SMPDEF
#define NOARG_SFP_TEX2Dh(name)  , texture2d<half> t_##name TEXDEF     , sampler s_##name SMPDEF
#define NOARG_SFP_TEX3D(name)   , texture3d<float> t_##name TEXDEF    , sampler s_##name SMPDEF
#define NOARG_SFP_TEX3Dh(name)  , texture3d<half> t_##name TEXDEF     , sampler s_##name SMPDEF
#define NOARG_SFP_TEXCUBE(name) , texturecube<float> t_##name TEXDEF  , sampler s_##name SMPDEF
#define NOARG_SFP_TEXCUBEh(name), texturecube<half> t_##name TEXDEF   , sampler s_##name SMPDEF

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

#define PASTE_STRINGS(xxx,yyy)              xxx ## yyy

#define EXT_VERTEXSHADER(xxx)               PASTE_STRINGS(VS_,xxx)
#define EXT_FRAGMENTSHADER(xxx)             PASTE_STRINGS(FS_,xxx)
#define EXT_LOCALUNIFORM(xxx)               PASTE_STRINGS(UL_,xxx)

#define NAME_vertex                         EXT_VERTEXSHADER(SHADERNAME)
#define NAME_fragment                       EXT_FRAGMENTSHADER(SHADERNAME)
#define UniformLocal                        EXT_LOCALUNIFORM(SHADERNAME)

#define DECL_SHADERSTART(type, output)      type output NAME_##type

