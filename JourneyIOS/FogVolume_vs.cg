#include "Migratory.sh"
// Notes:  Accumulates the amount of space inside of volumes.
//
//         Designed to be rendered to a floating point target.
//
// Author: John Edwards
// Date C: 6-2-2010

// From Phyre:

// Streams:
struct a2v
{
#ifdef __ORBIS__
	float4 Position VS_ATTR(POSITION);
#else
	float3 Position VS_ATTR(POSITION);
#endif
};

struct vs_v2f
{
	float4 position    FS_ATTR(POSITION);
	float4 uv          FS_ATTR(TEXCOORD0);
	float4 clip        FS_ATTR(TEXCOORD1);
	float3 world       FS_ATTR(TEXCOORD2);
};

#define v2f vs_v2f

//--------------------------------------------
// Program entry
//--------------------------------------------
//void main( in a2v IN, out v2f OUT)
//{

VS_START()

	output.position = MatrixMul( GET_LOCAL(modelViewProj), float4( input.Position.xyz, 1.0 ) );
	output.clip = output.position;
	output.uv = mul( SCALE_BIAS, output.position  );
	output.world = MatrixMul( GET_LOCAL(model), float4( input.Position.xyz, 1.0 ) ).xyz;

SH_END()

