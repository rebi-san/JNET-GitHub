#define GLOBAL_LEAN_AND_MEAN
#include "Migratory.sh"
// Increasing the register count reduces texture pipeline stalls in texture-heavy shaders.

#define ourBlendState NoBlend_BlendState
#define ourDepthStencilState NoDepthTest_NoDepthWrite_DepthState
#define ourRasterState NoCull_RasterizerState


#if defined(D_PLATFORM_GCM)
#pragma regcount 40
#endif

#ifndef _IOS64

struct IN
{
	float4 position        VS_ATTR(POSITION);
	float2 uv              VS_ATTR(TEXCOORD0);
};

struct OUT
{
    float4 color           : FINAL_COLOR;
};

#ifdef MSAA

Texture2DMS<float4> texMSAA;

#else

D_DECLARE_TEXTURE2D_4(tex);

#endif

#endif


//----------------------------------------------
// Resample
//    - This shader doesn't do any real work, it's 
//      meant for pass-through down/upsampling 
//
//----------------------------------------------
//void main( IN input, out OUT output )
//{

#ifdef SEPARATE_ALPHA

FS_START(float4,
    TEX2(
        2D, tex,
        2D, texAlpha),)

#else

FS_START(float4,
    TEX1(
        2D, tex),)

#endif

#ifdef MSAA
	uint2 dim;
	uint sampleCount;
	texMSAA.GetDimensions(dim.x, dim.y, sampleCount);

	float2 uvCoord = input.uv * float2(dim);

	float4 sample = texMSAA.Load(uvCoord, 0);
	float4 result = saturate(sample);
	float4 oversat = sample-result;			// we only want oversaturation from sample 0. given an edge going through an MSAA pixel, we have an elevated likelyhood of oversaturation.

	for (uint i = 1; i < sampleCount; ++i)
	{
		result += saturate(texMSAA.Load(uvCoord, i));
	}

	float4 col = oversat + (result / float(sampleCount));
#else
	float4 col = tex2D(tex, input.uv);

  #ifdef SEPARATE_ALPHA
    col.a = tex2D(texAlpha, input.uv).r;
  #endif

#endif

#ifdef TRAP_NAN
	float avg = dot(col,float4(1.0f,1.0f,1.0f,1.0f));
	output = isnan(avg) ? 0 : col;
#else
	output = col;
#endif

//}

SH_END()

