#include "Migratory.sh"
// Notes:  Deferred hacked ambient occlusion.
//
// Author: John Edwards
// Date C: 7-24-2010

// From Phyre.

#ifndef _IOS64

// Projection params:
float4 prjPlaneU;
float4 prjPlaneV;
float4 prjPlaneOrigin;

#ifdef COLOR_BIAS
 // The darkest the occlusion can get.  Should be somehow based of the environment ambient, probably.
 float4 colorBias;
 float4 colorScale;
#endif

#if defined(D_PLATFORM_GCM)
// For converting from Z buffer value to linear depth.
float depthBias;
float depthScale;
#endif
D_DECLARE_TEXTURE2D_4(depthTex);

#ifdef D_PLATFORM_D3D11
	#define D_D3D_STENCIL
	#include	"d3dutils.sh"
#else
D_DECLARE_TEXTURE2D_4(stencilTex);
#endif

D_DECLARE_TEXTURE2D_4(lightTex); // Light stored in the alpha channel.

#ifdef NOISE
#ifdef D_PLATFORM_GXM
 D_DECLARE_TEXTURE2D_4(noise3dTexture);
#else
 D_DECLARE_TEXTURE3D_4(noise3dTexture);
#endif
#endif

#ifdef PLAYER
 float4 metaballs0;
 float4 metaballs1;
 float4 metaballs2;
 float4 metaballs3;
 float4 metaballs4;
 float4 metaballs5; 
#endif

struct v2f
{
	float4 position      VS_ATTR(POSITION);
	float4 clip          VS_ATTR(TEXCOORD0);
	float3 tint          VS_ATTR(TEXCOORD1);
	float4 occPosRad     VS_ATTR(TEXCOORD2);
	float4 intShNoiseEx  VS_ATTR(TEXCOORD3);
};

struct f2f
{
	float4 color         : FINAL_COLOR;
};

#endif

//----------------------------------------------
// Helper functions
//----------------------------------------------
#define myTexDepth2D( depthTex,  uv ) tex2D( depthTex, uv ).r


//----------------------------------------------
// Program entry
//----------------------------------------------
//void main( in v2f IN, out f2f OUT )
//{


FS_START(float4,
    TEX4(
        2D, depthTex,
        2D, stencilTex,
        2D, lightTex,
        3D, noise3dTexture),)


	float2 uv = 0.5 * (input.clip.xy / input.clip.w + 1.0);
	float2 uvOrig = uv;
#if defined(D_PLATFORM_D3D11) || defined(_IOS64)
	uv.y = 1.0f - uv.y;
#endif
    float3 occPos = input.occPosRad.xyz; (void)occPos;
    float rad = input.occPosRad.w; (void)rad;
	float intensity = input.intShNoiseEx.x;
    float sharpness = input.intShNoiseEx.y; (void)sharpness;
    float noise = input.intShNoiseEx.z; (void)noise;




#ifdef PLAYER
    float lightTap = saturate( tex2D( lightTex, uv ).a - 1 );
#endif

	float depthTap = myTexDepth2D( depthTex, uv );
#if defined(D_PLATFORM_GCM)
	float z = depthScale / ( depthTap - depthBias  );
#else
	float z = ConvertDepth(UG, depthTap);
#endif	
	
#ifdef EXCLUSION
    float exclude = input.intShNoiseEx.w;
    float excludeOverride = saturate( tex2D( lightTex, uv ).a - 2 );
  #ifdef D_PLATFORM_D3D11
	float stencilTap = GetStencilMask(uv);
  #else
	float stencilTap = tex2D( stencilTex, uv ).r;
  #endif
#endif

	float3 projPointer = GET_LOCAL(prjPlaneOrigin.xyz) + (1 - uvOrig.x) * GET_LOCAL(prjPlaneU.xyz) + (1 - uvOrig.y) * GET_LOCAL(prjPlaneV.xyz);
	float3 camSpace = z * projPointer;
	float3 pos = GET_GLOBAL(eyePositionWS.xyz) - camSpace; // Ultimately, seems like it would be faster
	                                       // to calculate occlusion in camera space.

	float irradience = 1.0;

// If we're player ambient occlusion, we determine occlusion based on metaballs
// passed in through uniforms.  If we aren't occlusion is based on data passed
// in from the vertex shader.
#ifdef PLAYER
 #ifdef NOISE
  #ifdef D_PLATFORM_GXM
	half3 noiseTap = D_SAMPLE_TEXTURE( noise3dTexture, 0.25 * pos.xy ).rgb;
  #else
	half3 noiseTap = (half3)tex3D( noise3dTexture, 0.25 * pos ).rgb;
  #endif
	pos += (float3)(noise * (2 * noiseTap - 1));
 #endif

#define DO_META(_x)																		\
	{																										\
		float4 meta = GET_LOCAL(metaballs##_x);											\
		float3 metaPos = meta.xyz;												\
		float metaRad = meta.w;														\
		float3 to = metaPos - pos;												\
		to.y *= 0.25;																			\
		float dist = length( to );												\
		metaval += metaRad / (0.0001 + dist * dist);			\
	}

	float metaval = 0;
	DO_META(0)
	DO_META(1)
	DO_META(2)
	DO_META(3)
	DO_META(4)
	DO_META(5)

	const float kMetaCutoff = 0.70;
	metaval = saturate( kMetaCutoff + lerp( 7.0, 30.0, lightTap ) * (metaval - (1 - kMetaCutoff)) );
	irradience = saturate( 1 - metaval );
	irradience = lerp( 1.0 - intensity * (0.5 + 0.5 * lightTap), 1.0, irradience );
#else
 #ifdef NOISE
  #ifdef D_PLATFORM_GXM
	half3 noiseTap = D_SAMPLE_TEXTURE( noise3dTexture, 0.125 * pos.xy ).rgb;
  #else
	half3 noiseTap = (half3)tex3D( noise3dTexture, 0.125 * pos ).rgb;
  #endif
	pos += (float3)(noise * (2 * noiseTap - 1));
 #endif

	half3 to = (half3)(occPos - pos);
	half dist = length( to );
	half rd = saturate( (rad - dist) / rad );
	irradience *= saturate( 1.0 - rd * rd );

	//@PROTO: Modify the shadow softness.
	irradience = saturate( 0.5 + sharpness * (irradience - 0.5) );
	//@PROTO: Prevent the shadow from getting too dark.
	irradience = lerp( 1.0 - intensity, 1.0, irradience );
#endif

#ifdef EXCLUSION

	half exclusion = (1 - excludeOverride) * (abs( exclude - stencilTap * 256.0 ) < 0.75);
	irradience = lerp( irradience, 1.f, (float)exclusion );
#endif

	output.rgb = lerp( float3( 1.0, 1.0, 1.0 ), float3( irradience, irradience, irradience ), input.tint );

#ifdef COLOR_BIAS
	output.rgb = GET_LOCAL(colorScale.rgb) * output.rgb + GET_LOCAL(colorBias.rgb);
#endif

    //!MP! quick and dirty hack wrt level 6 hypersaturation bug
    float kMaxValue = GET_LOCAL(rangeClampMax);
    output.rgb = saturate(output.rgb/kMaxValue)*kMaxValue;

SH_END()

