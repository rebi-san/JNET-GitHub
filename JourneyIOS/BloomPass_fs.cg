#include "Migratory.sh"
// Notes:  Bloom happens in many recursive passes.  Before we start blooming, though, we
//         downsample the frame buffer repeatedly.  Then, starting at the most downsampled
//         buffer and working our way up, we blur the current buffer and composite it into
//         the bloom buffer.
//
// Author: John Edwards
// Date C: 3-31-2011

// Increasing the register count reduces texture pipeline stalls in texture-heavy shaders.

#if defined(D_PLATFORM_GCM)
#pragma regcount 16
#endif

#define ourBlendState NoBlend_BlendState
#define ourDepthStencilState NoDepthTest_NoDepthWrite_DepthState
#define ourRasterState NoCull_RasterizerState

#ifndef _IOS64

struct v2f
{
	float4 position    VS_ATTR(POSITION);
	float2 uv          VS_ATTR(TEXCOORD0);
};

struct f2f
{
    HALF4 color        : FINAL_COLOR;
};

HALF4 closeMult;
HALF4 farMult;
HALF size;

float4 offsets0;
float4 offsets1;
float4 offsets2;
float4 offsets3;



D_DECLARE_TEXTURE2D_4(texLo);
D_DECLARE_TEXTURE2D_4(texHi);

#endif


//----------------------------------------------
// Program entry
//----------------------------------------------

FS_START(float4,
    TEX2(
        2D, texLo,
        2D, texHi),)

    // Pull a tap from the low res buffer.
	HALF3 tapLo = (HALF3)tex2D( texLo, input.uv ).rgb;

	// Pull a blurred tap from the high res buffer.
	HALF3 tapHi =
		(HALF3)GET_LOCAL(closeMult.xyz) * (HALF3)tex2D( texHi, input.uv ).rgb +
		(HALF3)GET_LOCAL(farMult.xyz) * (HALF3)(tex2D( texHi, input.uv + GET_LOCAL(offsets0.xy) ).rgb +
		tex2D( texHi, input.uv + GET_LOCAL(offsets1.xy) ).rgb +
		tex2D( texHi, input.uv + GET_LOCAL(offsets2.xy) ).rgb +
		tex2D( texHi, input.uv + GET_LOCAL(offsets3.xy) ).rgb);

	// Maybe I should do a clamp at some point?
	//half maxChan = max( max( tap.r, tap.g ), tap.b );
	//half mult = min( 1.0, 320.0 / maxChan );	

	// Composite the two, scaling the low res.
	output.rgb = GET_LOCAL(size) * (float3)tapLo + (float3)tapHi;
	output.a = 1.0f;

SH_END()
