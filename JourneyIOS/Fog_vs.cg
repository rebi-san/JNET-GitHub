#include "Migratory.sh"
// Notes:  Very similar to the "resample" shader.  Provides an extra 3D uv
//         stream that contains a ray that points from the camera position
//         to a point at camera-space Z = 1.
//
// Author: John Edwards
// Date C: 7-21-2010

#ifndef _IOS64
// Projection param:
float4 projPlaneU;
float4 projPlaneV;
float4 projPlaneOrigin;

#endif

struct a2v
{
	float4 position    VS_ATTR(POSITION);
	float2 uv          VS_ATTR(TEXCOORD0);
};

struct v2f
{
	float4 position    FS_ATTR(POSITION);
	float2 uv          FS_ATTR(TEXCOORD0);
	float3 projPointer FS_ATTR(TEXCOORD1);
};

//----------------------------------------------
// Program entry
//----------------------------------------------
//void main( in p2v IN, out v2f OUT )
//{

VS_START()

#if defined(D_PLATFORM_D3D11)  || defined(_IOS64)
    output.position = float4(input.position.x,-input.position.y, input.position.z, 1);
#else
	output.position = input.position;
#endif
	output.uv = input.uv;
#if defined(D_PLATFORM_D3D11) || defined(_IOS64)
	output.projPointer = GET_LOCAL(projPlaneOrigin.xyz) + (1 - input.uv.x) * GET_LOCAL(projPlaneU.xyz) + (input.uv.y) * GET_LOCAL(projPlaneV.xyz);
#else
	output.projPointer = GET_LOCAL(projPlaneOrigin.xyz) + (1 - input.uv.x) * GET_LOCAL(projPlaneU.xyz) + (1 - input.uv.y) * GET_LOCAL(projPlaneV.xyz);
#endif


SH_END()
