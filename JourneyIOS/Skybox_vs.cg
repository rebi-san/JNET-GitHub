#include "Migratory.sh"

struct a2v
{
#if defined(__ORBIS__)
	float4 Position VS_ATTR(POSITION);
#else
	float3 Position VS_ATTR(POSITION);
#endif
	float2 uv           VS_ATTR(TEXCOORD0);
};

struct v2f
{
	float4 position    FS_ATTR(POSITION);
	float2 uv          FS_ATTR(TEXCOORD0);
	float3 eye         FS_ATTR(TEXCOORD1);
};

VS_START()

	output.position = MatrixMul( GET_LOCAL(modelViewProj), float4(input.Position.xyz,1) );
	output.position.z = output.position.w; // Project the skybox as far back as possible.
#if !defined(D_PLATFORM_GXM)
	output.position.z -= 0.00001f*output.position.w;//!MP! 0.0001f might be tiny or huge; it needs to be a fraction of the W component
#endif	
	output.uv = input.uv;
	output.eye = input.Position.xyz;

SH_END()

