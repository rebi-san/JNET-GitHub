#include "Migratory.sh"
// Authour: John Edwards
// Date C: 6-21-2007

#if defined(D_PLATFORM_GXM)
#undef SOFT
#endif


#ifndef _IOS64

#ifndef D_PREPASS_ENABLED

	// Both alpha and color modulation should come from this map.
	D_DECLARE_TEXTURE2D_4(tex);
	float alpha;
	float alphaFade;
	float scatter;
	HALF opacity;
	HALF alphaPremult;
	// Support scrolling uvs.
	#ifdef UV_OFFSET
	 float4 uvOffset;
	#endif

	#ifdef SOFT
	 #ifdef LOW_RES
		D_DECLARE_TEXTURE2D_4(depthTexLo);
	 #else
		D_DECLARE_TEXTURE2D_4(depthTex);
	 #endif
		float depthBias;
		float depthScale;
		float depthExtra;
		float softFadeoutRate;
	#endif

	#ifdef CLOUDTUBE
		float nearCutoff;
		float nearFadeDist;
		float farCutoff;
		float farFadeDist;
	#endif

#endif//D_PREPASS_ENABLED



// Stream structs:
struct v2f
{
	float4 position VS_ATTR(POSITION);
	float4 color    VS_ATTR(TEXCOORD0);
	float4 uv       VS_ATTR(TEXCOORD1);
	float3 normal   VS_ATTR(TEXCOORD2);
	float3 eye      VS_ATTR(TEXCOORD3);
#ifdef FOG
	float4 fog      VS_ATTR(TEXCOORD4);
#endif
#ifdef SOFT
	float4 pos      VS_ATTR(TEXCOORD5);
#endif
	float4 zDepth   VS_ATTR(TEXCOORD6);
};

struct f2f
{
	float4 color : FINAL_COLOR;
};

#endif

//----------------------------------------------
// Program entry
//----------------------------------------------
//void main( in v2f IN, out f2f OUT )
//{


#ifdef SOFT
    #ifdef LOW_RES
        FS_START(float4,TEX2(2D, tex, 2D,depthTexLo),)
    #else
        FS_START(float4,TEX2(2D, tex, 2D,depthTex),)
    #endif
#else
    FS_START(float4,TEX1(2D, tex),)
#endif






	float3 N = normalize(input.normal);
	float3 E = normalize(input.eye);
	float colorInt = 1-dot(N,E);

#ifdef UV_OFFSET
	input.uv.xy += GET_LOCAL(uvOffset.xy);
#endif

	float4 texColor = tex2D( tex, input.uv.xy );
	float4 baseColor = input.color * texColor;

#ifdef FOG
	// The correct behavior of the fog version of this shader is to fade out into the
	// fog.  Problem is, the other implementations didn't do that and it would be
	// dangerous to change it now, globally.
 #ifdef SPECULAR
	baseColor.a *= (1.0 - saturate(input.fog.a));
 #else
	baseColor.rgb = lerp( baseColor.rgb, input.fog.rgb, input.fog.a );
 #endif
#endif

	float a = saturate( input.uv.z * 5.0 ) * saturate(1-colorInt);

#ifdef SOFT
 #if defined( LOW_RES )
	float depth = manualTexDepth2Dproj( depthTexLo, input.pos );
 #else
	float depth = manualTexDepth2Dproj( depthTex, input.pos );
 #endif
 #if defined(D_PLATFORM_GCM)	
  float pdepth = depthScale / (depth - depthBias);
 #else
	float pdepth = ConvertDepth(UG, depth);
 #endif	
	float _distance = pdepth + GET_LOCAL(depthExtra) - input.pos.w;
	a *= clamp( GET_LOCAL(softFadeoutRate) * _distance, 0.f, 1.f );
#endif

// Fade out the mesh as the camera gets closer to it
#ifdef CLOUDTUBE
	float distFade = saturate( ( input.zDepth.x - GET_LOCAL(nearCutoff) ) / GET_LOCAL(nearFadeDist) ) *
        ( 1.0 - saturate( ( input.zDepth.x - GET_LOCAL(farCutoff) ) / GET_LOCAL(farFadeDist) ) );
	a *= distFade;
#else
	#ifndef NODEPTH
		a *= saturate( ( input.zDepth.x ) / 10 );
	#endif
#endif

	// The scattering shader has traditionally squared the alpha intensity.
	// Not about to break with tradition, now.
	float alphaMult = a * GET_LOCAL(alpha) * (1 - GET_LOCAL(alphaFade)) * GET_LOCAL(opacity);
	output = float4( baseColor.rgb, baseColor.a * alphaMult * alphaMult );

	// Certain render modes want premultiplied alpha.
	output.rgb *= GET_LOCAL(alphaPremult) * output.a + (1.0f - GET_LOCAL(alphaPremult));
//}

SH_END()

