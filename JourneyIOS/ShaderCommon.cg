#elif defined(__ORBIS__)

//-------------------------------------------------------------------------------
//	PS4
//-------------------------------------------------------------------------------

#	define	HW_COLOR(N)			S_TARGET_OUTPUT##N
#	define	HW_POSITION			S_POSITION
#	define	HW_DEPTH			S_DEPTH_OUTPUT

// hardware sprites done via geometry shader
#	define	SPRITECOORD			TEXCOORD0

// centroid parameter modifier - goes before type, like const
#	define	CENTROID(TYPE,NAME,SEMANTIC)			centroid TYPE NAME : SEMANTIC

// MB: Currently PS4 does not use halves?
#	define	half				float
#	define	half2				float2
#	define	half3				float3
#	define	half4				float4
#	define	half3x4				float3x4

// row major matrices
#pragma pack_matrix (row_major) 

// 6459 - semantic
// 5203 - paramter unref'd
// 5206 - local unref'd
#pragma warning (disable: 6459 5203 5206)

struct sampler2D
{
	Texture2D		tex;
	SamplerState	sampler;
};

struct samplerCUBE
{
	TextureCube		tex;
	SamplerState	sampler;
};

#if defined(__PSSL_PS__)
float4 tex2D( const sampler2D tex, float2 uv )
{
	return tex.tex.Sample(tex.sampler,uv);
}
float4 texCUBE( const samplerCUBE tex, float3 uv )
{
	return tex.tex.Sample(tex.sampler,uv);
}
#else
float4 tex2D( const sampler2D tex, float2 uv )
{
	return tex.tex.SampleLOD(tex.sampler,uv,0);
}
#endif

#define h4tex2D(X,Y)	((half4)tex2D(X,Y))
#define h3tex2D(X,Y)	((half3)tex2D(X,Y).rgb)
#define h2tex2D(X,Y)	((half2)tex2D(X,Y).rg)
#define h1tex2D(X,Y)	((half)tex2D(X,Y).r)
#define f1tex2D(X,Y)	(tex2D(X,Y).r)

#define h3texCUBE(X,Y)	((half3)texCUBE(X,Y).rgb)


float4 ReadTexProj( const sampler2D tex, float4 uv )
{
	return tex.tex.Sample(tex.sampler,uv.xy/uv.w);
}

float ReadDepth( const sampler2D tex, float2 uv )
{
	return tex.tex.Sample(tex.sampler,uv).r;
}
float ReadDepthProj( const sampler2D tex, float4 uv )
{
	return tex.tex.Sample(tex.sampler,uv.xy/uv.w).r;
}

int imodulo(float numer, uint denom)
{
	return ((int)floor(numer))%denom;
}


float alphaRef;
void DiscardLE( float alpha, float ref=alphaRef )
{
	if( alpha<=ref )
		discard;
}

void DiscardGE( float alpha, float ref=alphaRef )
{
	if( alpha>=ref )
		discard;
}

#elif defined(__psp2__)

//-------------------------------------------------------------------------------
//	vita
//-------------------------------------------------------------------------------

#	define	NATIVECOLOR		__nativecolor __regformat
#	define	REGFORMAT		__regformat
#	define	FRAGBLEND
#	if defined(MSAA)
#		define	MSAA __msaa
#	endif
#	define	CENTROID(TYPE,NAME,SEMANTIC)			TYPE NAME : SEMANTIC##_CENTROID

// 6204 - does not support default valueson uniforms
#pragma warning (disable: 6204)


half4 ReadTexProj( sampler2D tex, float4 uv )
{
	return tex2Dproj(tex,uv.xyw);
}

float ReadDepth( sampler2D tex, float2 uv )
{
	return tex2D<float>(tex,uv);
}

float ReadDepthProj( sampler2D tex, float4 uv )
{
	return tex2Dproj<float>(tex,uv.xyw);
}

int imodulo(float numer, float denom )
{
	return (int)floor(numer - floor(numer/denom)*denom);
}


float alphaRef;
void DiscardLE( float alpha, float ref=alphaRef )
{
	if( alpha <= ref )
		discard;
}
void DiscardLE( half alpha, half ref=(half)alphaRef )
{
	if( alpha <= ref )
		discard;
}
void DiscardGE( float alpha, float ref=alphaRef )
{
	if( alpha >= ref )
		discard;
}
void DiscardGE( half alpha, half ref=(half)alphaRef )
{
	if( alpha >= ref )
		discard;
}


#else

    #pragma error "unknown platform"

#endif




#ifndef PASS_UG
    #define PASS_UG
#endif

#ifndef UNIFORM_PASS_PARAM
    #define UNIFORM_PASS_PARAM
#endif

#ifndef CBG
    #define CBG(xxx)                xxx
#endif

#ifndef DEPTHTEX_SAMPLER
    #define DEPTHTEX_SAMPLER                sampler2D depthTex,
#endif





