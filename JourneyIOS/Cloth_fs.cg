//#endif


#ifdef _IOS64

    #define SAMPLE_ATLAS(a,b)    tex2D(a, b)
    #define SAMPLE_MASK(a,b)    tex2D(a, b)

#else

#if defined(DUDE)
// WRAPT??
	#define SAMPLE_ATLAS(a,b)	SAMPLETEX(a,b, ANISO, WRAP, ON)
	#define SAMPLE_MASK(a,b)	SAMPLETEX(a,b, ANISO, WRAP, ON)
#elif defined(SCARF)
	#define SAMPLE_ATLAS(a,b)	SAMPLETEX(a,b, ANISO, CLAMP, ON)
	#define SAMPLE_MASK(a,b)	SAMPLETEX(a,b, ANISO, CLAMP, ON)
#else
	#define SAMPLE_ATLAS(a,b)	SAMPLETEX(a,b, ANISO, WRAP, ON)
	#define SAMPLE_MASK(a,b)	SAMPLETEX(a,b, ANISO, WRAP, ON)
#endif

#endif

