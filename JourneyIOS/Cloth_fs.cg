	 ////#endif

		HALF hsvHue;
		HALF hsvSaturation;
		HALF hsvValue;
	////#endif

	////#if defined( DUDE ) || defined( SCARF )
		float dudeDissolve;
		float dudeSuperGlow;
		float dudeSnapGlow;
		float dudeSnapLevel;
		float4 dudeScarfRoot;
		float4 dudeCenter;

	////#endif

	////#ifdef DUDE
		float dudeColdness;
	////#endif

	////#ifdef SCARF
		// @HACK: Temporary solution to make the cape growing more visible.
		// Since cape growing is implemented using a vOffset, this is the approach we'll take.
		float vOffsetGlow;
	////#endif

	////#if defined( DECORATION ) && defined( DUDE )
		float dudeDecoGlow;
	////#endif

	// Sand params
	D_DECLARE_TEXTURE_CUBE_4(sandHiIrrCube);
	D_DECLARE_TEXTURE2D_4(sandSpecTexture);
	D_DECLARE_TEXTURE2D_4(sandSpecLut);
	#if defined( SAND )
		D_DECLARE_TEXTURE2D_4(noiseSandTex);
		D_DECLARE_TEXTURE2D_4(heightTexture);
		float4 heightBiasUv;
