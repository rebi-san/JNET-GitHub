//#if defined(DUDE)
//	#define SAMPLE_ATLAS(a,b) D_H4_SAMPLE_WRAPT_SRGBTEXTURE(a,b)
//	#define SAMPLE_MASK(a,b) D_H4_SAMPLE_WRAPT_SRGBTEXTURE(a,b)
//#elif defined(SCARF)
//	#define SAMPLE_ATLAS(a,b) D_H4_SAMPLE_SRGBTEXTURE(a,b)
//	#define SAMPLE_MASK(a,b) D_H4_SAMPLE_SRGBTEXTURE(a,b)
//#else
