#define knFragmentAttrTEXCOORD4			VS_ATTR(TEXCOORD4)
#define knFragmentAttrTEXCOORD5			VS_ATTR(TEXCOORD5)
#define knFragmentAttrTEXCOORD6			VS_ATTR(TEXCOORD6)
