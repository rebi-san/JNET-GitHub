#define DEPTHTEX_SAMPLER                psampler2D depthTex,

#define h4tex2D(X,Y)	(tex2D(X,Y))
#define h1tex2D(X,Y)	(h4tex2D(X,Y).r)
#define h2tex2D(X,Y)	(h4tex2D(X,Y).rg)
#define h3tex2D(X,Y)	(h4tex2D(X,Y).rgb)

#define f4tex2D(X,Y)	tex2D(X,Y)
#define f1tex2D(X,Y)	(f4tex2D(X,Y).r)
#define f2tex2D(X,Y)	(f4tex2D(X,Y).rg)
#define f3tex2D(X,Y)	(f4tex2D(X,Y).rgb)

#define h4texCUBE(X,Y)	(texCUBE(X,Y))
#define h1texCUBE(X,Y)	(h4texCUBE(X,Y).r))
#define h2texCUBE(X,Y)	(h4texCUBE(X,Y).rg)
#define h3texCUBE(X,Y)	(h4texCUBE(X,Y).rgb)

#define f4ReadTexProj(x,y)  ReadTexProj(x,y)
#define h4ReadTexProj(x,y)  ReadTexProj(x,y)

#define f1ReadDepth(x,y)    ReadDepth(x,y)
#define h1ReadDepth f1ReadDepth

#define f1ReadDepthProj(x,y)    ReadDepthProj(x,y)
#define h1ReadDepthProj(x,y)    ReadDepthProj(x,y)



DECL_CBUFFER_GLOBAL
{
    float4	blurZRanges;	//	[x] = fade in start
                                    //	[y] = 1/(fade start - fade end)
                                    //	[z] = fade out start
                                    //	[w] = 1/(fade out end - fade out start)

    // velvet
    float4   l_vf;	// velvetColor*velvetInt, velvetRatio, from GlobalShaderParam

    // lighting
    float4   l_c,l_a;
    float4   l_cf,l_af;		// l_c*l_i, l_a*l_ai, from GlobalShaderParam
    float3   l_d;
    float           l_i, l_ai, l_gi;

    // fog
    float4   f_cf, f_ff;	// fogCloseColor:fogCloseAlpha, fogFarColor:fogFarAlpha, from GlobalShaderParam
    float2   f_range;	// fogStart, 1.0/(fogEnd-fogStart), from GlobalShaderParam

    // blur
    float           depthBias;
    float           depthScale;
};

#ifdef PIXEL_SHADER

	#define ReadDepth(texSmp, uv)		t_##texSmp.Sample(s_##texSmp, uv.xy).r
	#define tex2D(texSmp, uv)			t_##texSmp.Sample(s_##texSmp, float2(uv))
	#define texCUBE(texSmp, uv)			t_##texSmp.Sample(s_##texSmp, float3(uv))
	
	#define ReadDepthProj(texSmp, uv)	t_##texSmp.Sample(s_##texSmp, uv.xy/uv.w).r
	#define ReadTexProj(texSmp, uv)		t_##texSmp.Sample(s_##texSmp, uv.xy/uv.w)

#else

	#define ReadDepth(texSmp, uv)		t_##texSmp.SampleLevel(s_##texSmp, uv.xy, 0).r
	#define tex2D(texSmp, uv)			t_##texSmp.SampleLevel(s_##texSmp, float2(uv), 0)
	#define texCUBE(texSmp, uv)			t_##texSmp.SampleLevel(s_##texSmp, float3(uv), 0)
	
	#define ReadDepthProj(texSmp, uv)	t_##texSmp.SampleLevel(s_##texSmp, uv.xy/uv.w, 0).r
	#define ReadTexProj(texSmp, uv)		t_##texSmp.SampleLevel(s_##texSmp, uv.xy/uv.w, 0)

#endif

inline int imodulo(float numer, uint denom)
{
    return ((int)floor(numer))%denom;
}

inline float3x3 ToF3x3(float4x4 m)
{
    return float3x3(m[0].xyz, m[1].xyz, m[2].xyz);
}

#define TEMPLATE_lerp(T0, T1) \
inline T0 lerp(T0 a, T0 b, T1 v) \
{ \
    return a + (b-a)*v; \
}


#define TEMPLATE_mul(M, V) \
inline V mul(M m, V v) \
{ \
    return v * m; \
}

inline void DiscardLE( float alpha, float ref )
{
    if( alpha<=ref )
        clip(-1);
}

inline void DiscardGE( float alpha, float ref )//=alphaRef
{
    if( alpha>=ref )
        clip(-1);
}

#define ADD_TECHNIQUE \
	technique SHADERNAME \
	{ \
		pass P0 \
		{ \
			SetVertexShader(CompileShader(vs_5_0, PASTE_STRINGS(VS_,SHADERNAME)())); \
			SetPixelShader(CompileShader(ps_5_0, PASTE_STRINGS(FS_,SHADERNAME)())); \
		} \
	}
