typedef struct
{
    SamplerState		smp;
    Texture2D<float4>	tex;
} psampler2D;

typedef struct
{
    SamplerState		smp;
    Texture2D<half4>     tex;
} psampler2Dh;

typedef struct
{
    SamplerState		smp;
    TextureCube<float4>	tex;
} psamplerCUBE;

typedef struct
{
    SamplerState		smp;
    TextureCube<half4>	tex;
} psamplerCUBEh;

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

#define PASTE_STRINGS(xxx,yyy)          xxx ## yyy
#define BAKE_STRING(xxx)				xxx

#define PARAM_
#define SMP_

#define TARGET_OUTPUT					: SV_TARGET

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

#define CB_REGISTER(index)		PASTE_STRINGS(b, index)
#define SFP_UNIFORM             
#define SFP_INPUT(decl)         in decl

#define SAMPLER(type, name)     

#define SFP_TEX2D(name, idx)                        \
    , Texture2D<float4> t_##name : register(t##idx)	  \
    , SamplerState s_##name : register(s##idx)

#define SFP_TEX2Dh(name, idx)                       \
    , Texture2D<half4> t_##name : register(t##idx)     \
    , SamplerState s_##name : register(s##idx)

#define SFP_TEXCUBE(name, idx)                      \
    , TextureCube<float4> t_##name : register(t##idx)  \
    , SamplerState s_##name : register(s##idx)

#define SFP_TEXCUBEh(name, idx)                     \
    , TextureCube<half4> t_##name : register(t##idx)   \
    , SamplerState s_##name : register(s##idx)

	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

#define EXT_VERTEXSHADER(xxx)               PASTE_STRINGS(VS_,xxx)
#define EXT_FRAGMENTSHADER(xxx)             PASTE_STRINGS(FS_,xxx)
#define EXT_LOCALUNIFORM(xxx)               PASTE_STRINGS(UL_,xxx)

#define NAME_vertex                         EXT_VERTEXSHADER(Main)
#define NAME_fragment                       EXT_FRAGMENTSHADER(Main)
#define UniformLocal                        EXT_LOCALUNIFORM(SHADERNAME)

#define DECL_SHADERSTART(type, output)      output NAME_##type

#define NO_PARAM	, int ignore

#define UNIFORM_ED_ENABLE                   SFP_UNIFORM
#define UNIFORM_ED_DISABLE
#define UNIFORM_ED_GET(xxx)                 UNIFORM_ED_##xxx


#define TEX_TYPE(xxx)                       SFP_TEX##xxx

#define TEX_TEX1(aaa)                                                   TEX_TYPE(aaa)
#define TEX_TEX2(aaa,bbb)                   TEX_TEX1(aaa)               TEX_TYPE(bbb)
#define TEX_TEX3(aaa,bbb,ccc)               TEX_TEX2(aaa,bbb)           TEX_TYPE(ccc)
#define TEX_TEX4(aaa,bbb,ccc,ddd)           TEX_TEX3(aaa,bbb,ccc)       TEX_TYPE(ddd)
#define TEX_TEX5(aaa,bbb,ccc,ddd,eee)       TEX_TEX4(aaa,bbb,ccc,ddd)   TEX_TYPE(eee)


// this is the definition
#define TEX1(type0,name0)                                                   TEX_TEX1(type0(name0,0))
#define TEX2(type0,name0,type1,name1)                                       TEX_TEX2(type0(name0,0), type1(name1,1))
#define TEX3(type0,name0,type1,name1,type2,name2)                           TEX_TEX3(type0(name0,0), type1(name1,1), type2(name2,2))
#define TEX4(type0,name0,type1,name1,type2,name2,type3,name3)               TEX_TEX4(type0(name0,0), type1(name1,1), type2(name2,2),  type3(name3,3))
#define TEX5(type0,name0,type1,name1,type2,name2,type3,name3,type4,name4)   TEX_TEX5(type0(name0,0), type1(name1,1), type2(name2,2),  type3(name3,3),  type4(name4,4))


#define PVS_NO_PARAM
#define PVS_TEX_ENABLED                                                         , const VS_ArgBuffer arg
#define PVS_TEX1(type0,name0)                                                   PVS_TEX_ENABLED
#define PVS_TEX2(type0,name0,type1,name1)                                       PVS_TEX_ENABLED
#define PVS_TEX3(type0,name0,type1,name1,type2,name2)                           PVS_TEX_ENABLED
#define PVS_TEX4(type0,name0,type1,name1,type2,name2,type3,name3)               PVS_TEX_ENABLED
#define PVS_TEX5(type0,name0,type1,name1,type2,name2,type3,name3,type4,name4)   PVS_TEX_ENABLED

#define PFS_NO_PARAM
#define PFS_TEX_ENABLED                                                         , const FS_ArgBuffer arg
#define PFS_TEX1(type0,name0)                                                   PFS_TEX_ENABLED
#define PFS_TEX2(type0,name0,type1,name1)                                       PFS_TEX_ENABLED
#define PFS_TEX3(type0,name0,type1,name1,type2,name2)                           PFS_TEX_ENABLED
#define PFS_TEX4(type0,name0,type1,name1,type2,name2,type3,name3)               PFS_TEX_ENABLED
#define PFS_TEX5(type0,name0,type1,name1,type2,name2,type3,name3,type4,name4)   PFS_TEX_ENABLED

// this casts the arguments to local variables by better names
#define SMP_NO_PARAM
#define SMP_TEX1(type0,name0)                                                                                                                       SAMPLER(type0, name0)
#define SMP_TEX2(type0,name0, type1,name1)                                          SMP_TEX1(type0,name0);                                          SAMPLER(type1, name1)
#define SMP_TEX3(type0,name0, type1,name1, type2,name2)                             SMP_TEX2(type0,name0, type1,name1);                             SAMPLER(type2, name2)
#define SMP_TEX4(type0,name0, type1,name1, type2,name2, type3,name3)                SMP_TEX3(type0,name0, type1,name1, type2,name2)                 SAMPLER(type3, name3)
#define SMP_TEX5(type0,name0, type1,name1, type2,name2, type3,name3, type4,name4)   SMP_TEX4(type0,name0, type1,name1, type2,name2, type3,name3)    SAMPLER(type4, name4)

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

#define VS_BEGIN(ufEnable, output_type, output_name, input_type, input_name, param) \
    DECL_SHADERSTART(vertex, output_type)(                                          \
        UNIFORM_ED_GET(ufEnable)                                                    \
        SFP_INPUT(input_type input_name)                                            \
        param)                                                                      \
    {                                                                               \
        output_type output_name;                                                    \
        SMP_##param

#define VS_END(output_name)                                                         \
        return output_name;                                                         \
    }


#define FS_BEGIN(ufEnable, output_type, output_name, input_type, input_name, param) \
    DECL_SHADERSTART(fragment, output_type)(                                        \
        UNIFORM_ED_GET(ufEnable)                                                    \
        SFP_INPUT(input_type input_name)                                            \
        param) TARGET_OUTPUT														\
    {                                                                               \
        output_type output_name;                                                    \
        SMP_##param

#define FS_END(output_name)                                                         \
        return output_name;                                                         \
    }


