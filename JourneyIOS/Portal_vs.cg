#include "Migratory.sh"
// Author: John Edwards
// Date C: 8-12-2008

#define SOFT

#ifndef _IOS64

// Portal uniforms.
float4 depths;
float alphaFade;

#endif



// Stream structs:
struct a2v
{
	float4 position     VS_ATTR(POSITION);
	float3 normal       VS_ATTR(NORMAL);
	float4 color        VS_ATTR(COLOR0);
	float2 uv			VS_ATTR(TEXCOORD0);
};

struct v2f
{
	float4 clipSpace    FS_ATTR(POSITION);
	float4 color        FS_ATTR(COLOR0);
	float3 normal       FS_ATTR(TEXCOORD0);
	float3 eye          FS_ATTR(TEXCOORD1);
	float2 uv           FS_ATTR(TEXCOORD2);
	float4 uv0          FS_ATTR(TEXCOORD3);
	float4 uv1          FS_ATTR(TEXCOORD4);
#ifdef SOFT
	float4 pos          FS_ATTR(TEXCOORD5);
#endif

};

//----------------------------------------------
// Program entry
//----------------------------------------------
//void main( a2v IN, out v2f OUT )
//{

VS_START()

    output.clipSpace = MatrixMul( GET_LOCAL(modelViewProj), float4(input.position.xyz,1.0f) );
	output.color = input.color;

	output.normal = MatrixMul( ToM3x3(GET_LOCAL(modelIT)), input.normal );
	float3 worldPos = ( MatrixMul( GET_LOCAL(model), float4(input.position.xyz,1.0f) ) ).xyz;
	output.eye = GET_GLOBAL(eyePositionWS.xyz) - worldPos;


	output.uv = input.uv;

	float3 inBasis = GET_LOCAL(eyePositionOS.xyz) - input.position.xyz;
	inBasis.x *= -0.5;
	inBasis.y *= -1;

	output.uv0.xy = (input.uv - float2( 0.5, 0.5 ));
	output.uv0.zw = (input.uv - float2( 0.5, 0.5 ));
	output.uv1.xy = (input.uv - float2( 0.5, 0.5 ));
	output.uv1.zw = (input.uv - float2( 0.5, 0.5 ));

	float2 skew = float2( inBasis.x / inBasis.z, inBasis.y / inBasis.z );
	output.uv0.xy += skew * GET_LOCAL(depths.x);
	output.uv0.zw += skew * GET_LOCAL(depths.y);
	output.uv1.xy += skew * GET_LOCAL(depths.z);
	output.uv1.zw += skew * GET_LOCAL(depths.w);

	output.uv0.xy = output.uv0.xy / (1.0 + GET_LOCAL(depths.x)) + float2( 0.5, 0.5 );
	output.uv0.zw = output.uv0.zw / (1.0 + GET_LOCAL(depths.y)) + float2( 0.5, 0.5 );
	output.uv1.xy = output.uv1.xy / (1.0 + GET_LOCAL(depths.z)) + float2( 0.5, 0.5 );
	output.uv1.zw = output.uv1.zw / (1.0 + GET_LOCAL(depths.w)) + float2( 0.5, 0.5 );

	output.color.a *= 1.0 - GET_LOCAL(alphaFade);



#ifdef SOFT
	output.pos = mul( SCALE_BIAS, output.clipSpace );
	output.pos.w = output.clipSpace.w;
#endif

SH_END()
