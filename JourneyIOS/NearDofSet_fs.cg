#include "Migratory.sh"
// Notes:  Pulls only the (negative) near DoF values from a texture with
//         DoF encoded in the alpha.
//
// Author: John Edwards
// Date C: 3-21-2011


#define ourBlendState NoBlend_BlendState
#define ourDepthStencilState NoDepthTest_NoDepthWrite_DepthState
#define ourRasterState NoCull_RasterizerState

#ifndef _IOS64

struct v2f
{
	float4 position        VS_ATTR(POSITION);
	float2 uv              VS_ATTR(TEXCOORD0);
};

struct f2f
{
    float4 color           : FINAL_COLOR;
};

D_DECLARE_TEXTURE2D_4(tex);

#endif


//----------------------------------------------
// Program entry
//----------------------------------------------
//void main( v2f IN, out f2f OUT )
//{

FS_START(float4,
    TEX1(
        2D, tex),)

	float4 tap = tex2D( tex, input.uv );
	output.a = saturate( -tap.a );

SH_END()
