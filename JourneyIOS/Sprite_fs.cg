#include "Migratory.sh"
// Notes:  About as simple as you can get.  For now ...
//
// Author: John Edwards
// Date C: 4-5-2008

struct IN
{
	float4 position    VS_ATTR(POSITION);
	float2 uv          VS_ATTR(TEXCOORD0);
	float4 color       VS_ATTR(COLOR0);
};

struct OUT
{
    float4 color           : FINAL_COLOR;
};

D_DECLARE_TEXTURE2D_4(tex);

//----------------------------------------------
// Program entry
//----------------------------------------------
void main( IN input, out OUT output )
{
	output.color = input.color * tex2D(tex, input.uv);
}
