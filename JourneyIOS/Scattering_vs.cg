#define GLOBAL_LEAN_AND_MEAN
#include "Migratory.sh"

#ifndef _IOS64

float4		eyePositionWS		: eyePositionWS;
float4		cameraNear			: cameraNearFar;
#ifdef SKINNING_ENABLED
float4x4	viewprojection		: viewprojection;
#else
float4x4	model				: model			;
float4x4	modelIT				: modelit		;	
float4x4	modelViewProj		: modelviewproj	;
#endif
#if defined(D_PLATFORM_GXM)
#undef SOFT
#endif


#ifndef D_PREPASS_ENABLED

	float4 mltColor;

	#ifdef SPECULAR
		HALF4 l_d;

		HALF4 fresnelColor;
		HALF fresnelFalloff;
	#endif

	#ifdef FOG
		float4 f_se;       // fogStart/fogEnd
		float4 f_cc, f_fc; // fogCloseColor, fogFarColor
	#endif

#endif//D_PREPASS_ENABLED


#ifdef ADDITIVE_ZHACK
    float gAdditiveZHack;
#endif


#endif


#ifdef SKINNING_ENABLED

struct a2v
{
#if defined(__ORBIS__)
	float4	SkinnableVertex VS_ATTR(POSITION);
#else
	float3	SkinnableVertex VS_ATTR(POSITION);
#endif
	float3	SkinnableNormal VS_ATTR(NORMAL);
	float4 color    VS_ATTR(COLOR0);
	float2 uv       VS_ATTR(TEXCOORD0);
	float4	SkinWeights VS_ATTR(BLENDWEIGHT);
#if defined(D_PLATFORM_GXM)
	int4	SkinIndices VS_ATTR(BLENDINDICES);
#else
	int4	SkinIndices VS_ATTR(BLENDINDICES);
#endif
};
#else

struct a2v
{
#if defined(__ORBIS__)
	float4 position VS_ATTR(POSITION);
	float4 normal   VS_ATTR(NORMAL);
#else
	float3 position VS_ATTR(POSITION);
	float3 normal   VS_ATTR(NORMAL);
#endif
	float4 color    VS_ATTR(COLOR0);
	float2 uv       VS_ATTR(TEXCOORD0);
};

#endif


#if defined(SKINNING_ENABLED) && !defined(D_PREPASS_ENABLED)

struct a2v_noSkin
{
	float4 position VS_ATTR(POSITION);
	float3 normal   VS_ATTR(NORMAL);
	float4 color    VS_ATTR(COLOR0);
	float2 uv       VS_ATTR(TEXCOORD0);
};

a2v_noSkin ProcessSkInput(PASS_UL a2v skIn)
{
#ifdef _IOS64
    float3x4    transformMatrix = GenerateBoneMatrix(UL.skinMatrices,  skIn.SkinIndices,skIn.SkinWeights);
#else
    float4x4    transformMatrix = GenerateBoneMatrix(UL.skinMatrices,  skIn.SkinIndices,skIn.SkinWeights);
#endif

	a2v_noSkin ret;

	ret.position = SkinTransform(transformMatrix, float4(skIn.SkinnableVertex.xyz, 1));//  MatrixMul(transformMatrix,float4(skIn.SkinnableVertex.xyz,1)).xyz;
#ifdef _IOS64
    ret.normal = MatrixMul(ToM3x3(transformMatrix), skIn.SkinnableNormal);
#else
    ret.normal = MatrixMul((float3x3)transformMatrix, skIn.SkinnableNormal);
#endif
	ret.color = skIn.color;
	ret.uv = skIn.uv;

	return ret;
}

#endif//SKINNING_ENABLED

struct v2f
{
	float4 position FS_ATTR(POSITION);
	float4 color    FS_ATTR(TEXCOORD0);
	float4 uv       FS_ATTR(TEXCOORD1);
	float3 normal   FS_ATTR(TEXCOORD2);
	float3 eye      FS_ATTR(TEXCOORD3);
#ifdef FOG
	float4 fog      FS_ATTR(TEXCOORD4);
#endif
#ifdef SOFT
	float4 pos      FS_ATTR(TEXCOORD5);
#endif
	float4 zDepth   FS_ATTR(TEXCOORD6);
};



//--------------------------------------------
// Simple vertex shader
// Passes color and texture information on to
// the frag shader.
//--------------------------------------------
/*
void main(
#ifdef SKINNING_ENABLED
	in a2v IN_VAL,
#else
	in a2v IN,
#endif
	out v2f OUT)
{
*/



VS_START()


#ifdef SKINNING_ENABLED
	a2v_noSkin IN = ProcessSkInput(UL, input);
    float4 inPos = float4( IN.position.xyz, 1 );
    float3 normal = IN.normal.xyz;
#else
    float4 inPos = float4( input.position.xyz, 1 );
    float3 normal = input.normal.xyz;
#endif



#ifdef ADDITIVE_ZHACK
	inPos.xyz += normal*GET_LOCAL(gAdditiveZHack);
#endif

#ifdef SKINNING_ENABLED
	output.position = MatrixMul( GET_LOCAL(modelViewProj), inPos );
	output.normal = normalize(MatrixMul( ToM3x3(GET_LOCAL(model)), normal ));
	float3 worldPos = MatrixMul( GET_LOCAL(model), float4(IN.position.xyz,1)).xyz;
#else
	output.position = MatrixMul( GET_LOCAL(modelViewProj), inPos );
	output.normal = normalize(MatrixMul( ToM3x3(GET_LOCAL(modelIT)), normal ));
	float3 worldPos = ( MatrixMul( GET_LOCAL(model), float4(input.position.xyz,1.0f) ) ).xyz;
#endif



	output.eye = GET_GLOBAL(eyePositionWS.xyz) - worldPos;
	input.color.rgb = input.color.rgb * GET_LOCAL(mltColor.xyz);
	output.color = input.color;
	output.uv.xy = input.uv;
	output.uv.zw = output.position.zw;

#ifdef SPECULAR
	// Calculate the fresnel term of specular.
  #ifdef _IOS64
    float3 Ln = normalize( GET_GLOBAL(l_d.xyz) );
    float3 Vn = normalize( output.eye );
    float3 Hn = ( Vn + Ln );
    if(length(Hn)>0.001f)
        Hn = normalize( Hn );
  #else
    half3 Ln = (half3)normalize( GET_GLOBAL(l_d.xyz) );
    half3 Vn = (half3)normalize( output.eye );
	half3 Hn = (half3)normalize( Vn + Ln );
  #endif
	half3 fresnel = lerp( (half3)GET_LOCAL(fresnelColor.rgb), half3(1.0,1.0,1.0f), pow( saturate( 1.0 - dot( Vn, Hn ) ), (5.0 * (1.0 + GET_LOCAL(fresnelFalloff))) ) );
	output.color.rgb *= (float3)fresnel;
#endif

#ifdef FOG
	float3 pos = worldPos;
	float3 eye = float3( GET_GLOBAL(eyePositionWS.xyz) - pos.xyz );
	float rayS = min( GET_GLOBAL(eyePositionWS.y), pos.y );
	float rayE = max( GET_GLOBAL(eyePositionWS.y), pos.y ) + 0.5; // Prevent div by 0.
	float rayH = rayE - rayS;
	float fogS = GET_GLOBAL(f_se.z);
	float fogE = GET_GLOBAL(f_se.w);
	float fogH = fogE - fogS;
	float midS = min( rayS, fogE );
	float midE = min( rayE, fogE );
	float midA = 0.5 * (midS + midE);
	float midH = midE - midS;
	float fogY = ((fogE - midA) * midH) / (fogH * rayH);
	float fogRatio = saturate( (fogY * length( eye ) - GET_GLOBAL(f_se.x)) / (GET_GLOBAL(f_se.y) - GET_GLOBAL(f_se.x)) );
	fogRatio = fogRatio*fogRatio;
	float3 fogColor = lerp( GET_GLOBAL(f_cc.rgb), GET_GLOBAL(f_fc.rgb), fogRatio );
	float fogAlpha = lerp( GET_GLOBAL(f_cc.a), GET_GLOBAL(f_fc.a), fogRatio );
	output.fog = float4( fogColor, fogRatio*fogAlpha );
	//OUT.fog.a = 0;
#endif

#ifdef SOFT
	output.pos = mul( SCALE_BIAS, output.position  );
	output.pos.w = output.position.w;
#endif

//#ifdef CLOUDTUBE
	output.zDepth.x = output.position.w - GET_GLOBAL(cameraNear);
//#endif

SH_END()

