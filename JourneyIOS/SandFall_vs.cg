#define GLOBAL_LEAN_AND_MEAN
#include "Migratory.sh"

#ifndef _IOS64

float4x4	modelIT				: modelit;
float4x4	modelViewProj		: modelviewproj;
float4x4	model				: model;
float4		eyePositionWS		: eyePositionWS;

// Shader for use on sand waterfalls. This shader takes in a color texture and a 
// mask texture. The mask texture is dynamically generated by the sand module
// based on the player's position within the waterfall.
//
// Author: Nick Clark
// Date C: 4-14-2010

// From Phyre:

// For sand module
float4 obbCenter_Width;
float4 obbHeight_vOff;

#ifdef CHAM
 HALF4 chamValues; // { chamLevel, intensity }
#endif

#endif

// Streams:
struct a2v
{
	float4 position    VS_ATTR(POSITION);
	HALF4  color       VS_ATTR(COLOR0);
#ifdef HALVES_ENABLED
    HALF4  normal      VS_ATTR(NORMAL);
#else
	HALF3  normal      VS_ATTR(NORMAL);
#endif
	float4 uv          VS_ATTR(TEXCOORD0);
	float4 uv2         VS_ATTR(TEXCOORD1);
};

struct vs_v2f
{
	float4 position    FS_ATTR(POSITION);
	half4  color       FS_ATTR(COLOR0);
	float4 uv          FS_ATTR(TEXCOORD0);
	float4 uv2         FS_ATTR(TEXCOORD1);
	half3  normal      FS_ATTR(TEXCOORD2);
	float4 loc         FS_ATTR(TEXCOORD3);
	float4 eye         FS_ATTR(TEXCOORD4);
};

#define v2f vs_v2f

//--------------------------------------------
// Program entry
//--------------------------------------------

VS_START()

    output.position = MatrixMul( GET_LOCAL(modelViewProj), float4( input.position.xyz, 1 ) );
	output.color = (half4)input.color;

	float4 pos = MatrixMul( GET_LOCAL(model), float4( input.position.xyz, 1 ) );
	output.loc.xyz = pos.xyz;
	output.eye = float4( GET_GLOBAL(eyePositionWS.xyz) - output.loc.xyz, 1 );

	output.uv.xy = input.uv.xy;
	output.uv.zw = input.uv.zw;

	// x-y planar projection 
	float3 obbCenter = GET_LOCAL(obbCenter_Width.xyz);
	float obbWidth = GET_LOCAL(obbCenter_Width.w);
	float obbHeight = GET_LOCAL(obbHeight_vOff.x);
	float xDist = input.position.x - (obbCenter.x - obbWidth);
	float yDist = input.position.y - (obbCenter.y - obbHeight);
	output.uv2.xy = float2( xDist / ( obbWidth * 2 ), yDist / ( obbHeight * 2 ) );
	output.uv2.zw = float2(0,0);

	output.normal = (half3)normalize( MatrixMul( ToM3x3(GET_LOCAL(modelIT)), (float3)input.normal.xyz ) );

#ifdef CHAM
	output.loc.w = input.position.y - GET_LOCAL(chamValues.x);
#else
	output.loc.w = 0;
#endif

SH_END()


