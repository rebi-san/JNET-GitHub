#include "Migratory.sh"

struct a2v
{
float2    loc            VS_ATTR(TEXCOORD0);
float2    uv            VS_ATTR(TEXCOORD1);
float2    spriteIdx    VS_ATTR(TEXCOORD2);
};

struct v2f
{
float4    position        FS_ATTR(POSITION);
float2    srcUv            FS_ATTR(TEXCOORD0);
float2    alphaUv            FS_ATTR(TEXCOORD1);
#ifdef PERFTEST
float2    totalToss        FS_ATTR(TEXCOORD2);
float4 color            FS_ATTR(TEXCOORD3);
#endif
};


#ifndef _IOS64


// these should be set externally, and should not be constants
float spriteSizeOverRTSize;        // sprite width over width of sand texture rendertarget (width=height)

float ooSrcSpriteCount;
float ooAlphaSpriteCount;


#ifdef PERFTEST
float spriteSizeTexScalar;
#endif

#endif



//----------------------------------------------
// Program entry
//----------------------------------------------
VS_START()

#ifdef PERFTEST
float2 pos = frac(input.loc.xy) * 2 - 1;
float rot = (0.5f + floor(input.loc.x)) * 3.141592f / 2.f;
float2 dsp = float2(cos(rot), sin(rot));
float2 posDisp = dsp / sqrt(2.f);
float2 uvDisp = posDisp + 0.5f;

pos += GET_LOCAL(spriteSizeOverRTSize) * posDisp;

float2 srcUV = input.uv + uvDisp*GET_LOCAL(spriteSizeTexScalar);
float2 alphaUV = input.spriteIdx + uvDisp*GET_LOCAL(spriteSizeTexScalar);



float4    randomCalcBS = float4(length(input.uv), length(input.spriteIdx), 0, 0);

randomCalcBS.xy /= (1+dot(randomCalcBS.xy, randomCalcBS.xy));
randomCalcBS.z = pow(randomCalcBS.x, 7.3f);
randomCalcBS.w = pow(randomCalcBS.y, 2.1f);
randomCalcBS *= dot(randomCalcBS.zw, randomCalcBS.zw);

output.totalToss = randomCalcBS.xy;
output.color = float4(srcUV, alphaUV);

#else
float2    pos =        (input.loc + (input.uv-0.5f)*GET_LOCAL(spriteSizeOverRTSize));

float2    srcUV =        float2(GET_LOCAL(ooSrcSpriteCount),1)   * (float2(input.spriteIdx.x,0)+input.uv);
float2    alphaUV =    float2(GET_LOCAL(ooAlphaSpriteCount),1) * (float2(input.spriteIdx.y,0)+input.uv);
#endif


#if defined(D_PLATFORM_D3D11) || defined(_IOS64)
pos *=        float2(1,-1);
#endif

output.position = float4(pos,0.5f,1);
output.srcUv = srcUV;
output.alphaUv = alphaUV;

SH_END()

