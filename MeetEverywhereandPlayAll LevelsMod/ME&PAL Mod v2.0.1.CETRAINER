  <CheatEntries>
    <CheatEntry>
      <ID>425434</ID>
      <Description>"Advanced Options [Hotkeys]"</Description>
      <Options moHideChildren="1"/>
      <LastState Value="" RealAddress="00000000"/>
      <Color>0000FF</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>425448</ID>
          <Description>"Meet companions everywhere [alt+T = on; alt+Y = off]"</Description>
          <ShowAsHex>1</ShowAsHex>
          <ShowAsSigned>0</ShowAsSigned>
          <VariableType>Array of byte</VariableType>
          <ByteLength>10</ByteLength>
          <Address>Journey.exe+187F67</Address>
          <Hotkeys>
            <Hotkey>
              <Action>Set Value</Action>
              <Keys>
                <Key>18</Key>
                <Key>89</Key>
              </Keys>
              <Value>66 C7 41 08 01 01</Value>
              <Description>Normal meeting mode: can't meet anywhere "special"</Description>
              <ID>0</ID>
            </Hotkey>
            <Hotkey>
              <Action>Set Value</Action>
              <Keys>
                <Key>18</Key>
                <Key>84</Key>
              </Keys>
              <Value>66 C7 41 08 00 00</Value>
              <Description>Meet companions everywhere</Description>
              <ID>1</ID>
            </Hotkey>
            <Hotkey>
              <Action>Set Value</Action>
              <Keys>
                <Key>18</Key>
                <Key>71</Key>
              </Keys>
              <Value>66 C7 41 08 00 00</Value>
              <Description>Connect everywhere (but CAN'T MEET in Chapter Select/Credits levels)</Description>
              <ID>2</ID>
            </Hotkey>
          </Hotkeys>
        </CheatEntry>
        <CheatEntry>
          <ID>425449</ID>
          <Description>"Always see true companion [alt+T = on; alt+Y = off]"</Description>
          <ShowAsHex>1</ShowAsHex>
          <ShowAsSigned>0</ShowAsSigned>
          <VariableType>Array of byte</VariableType>
          <ByteLength>10</ByteLength>
          <Address>Journey.exe+0170E22</Address>
          <Hotkeys>
            <Hotkey>
              <Action>Set Value</Action>
              <Keys>
                <Key>18</Key>
                <Key>89</Key>
              </Keys>
              <Value>66 C7 42 09 00 01</Value>
              <Description>Companion sometimes controlled by game ("Nick")</Description>
              <ID>0</ID>
            </Hotkey>
            <Hotkey>
              <Action>Set Value</Action>
              <Keys>
                <Key>18</Key>
                <Key>84</Key>
              </Keys>
              <Value>66 C7 42 09 00 00</Value>
              <Description>See companion's true animations</Description>
              <ID>1</ID>
            </Hotkey>
            <Hotkey>
              <Action>Set Value</Action>
              <Keys>
                <Key>18</Key>
                <Key>71</Key>
              </Keys>
              <Value>66 C7 42 09 00 01</Value>
              <Description>Turn on Nick for "connect everywhere"</Description>
              <ID>2</ID>
            </Hotkey>
          </Hotkeys>
        </CheatEntry>
        <CheatEntry>
          <ID>425450</ID>
          <Description>"Move in credits levels [alt+I = on; alt+O = off]"</Description>
          <ShowAsHex>1</ShowAsHex>
          <ShowAsSigned>0</ShowAsSigned>
          <VariableType>Array of byte</VariableType>
          <ByteLength>8</ByteLength>
          <Address>Journey.exe+017DABA</Address>
          <Hotkeys>
            <Hotkey>
              <Action>Set Value</Action>
              <Keys>
                <Key>18</Key>
                <Key>79</Key>
              </Keys>
              <Value>88 43 09 48 8B 5C 24 30</Value>
              <Description>Disable controls in credits (And avoid related negative bugs)</Description>
              <ID>0</ID>
            </Hotkey>
            <Hotkey>
              <Action>Set Value</Action>
              <Keys>
                <Key>18</Key>
                <Key>73</Key>
              </Keys>
              <Value>66 C7 43 09 00 00 90 90</Value>
              <Description>Enable controls in Credits 1 + 2 (And cause negative bugs in other levels)</Description>
              <ID>1</ID>
            </Hotkey>
          </Hotkeys>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
